{
  "id": "asset-operation-workflows",
  "version": "0.4.0",
  "schema": "/data/operations/schemas/workflow.schema.json",
  "status": "foundation",
  "runtimeStatus": "consumed-by-asset-automation",
  "createdAt": "2026-07-10",
  "updatedAt": "2026-07-14",
  "owner": "Calcule Trabalhador",
  "source": "Operational Capabilities Phase 4.8 - Generic Asset Provisioning",
  "description": "Single workflow for generic internal draft asset provisioning.",
  "workflows": [
    {
      "workflowId": "create-asset-workflow",
      "operationId": "create-asset",
      "steps": [
        "input",
        "resolve-defaults",
        "resolve-pam",
        "resolve-blueprint",
        "resolve-gold-standard",
        "resolve-reference",
        "when-calculator-open-physical-reference",
        "when-calculator-decompose-reference-modules",
        "when-calculator-resolve-institutional-theme-and-visible-updated-at",
        "when-calculator-classify-form-result-and-memory",
        "when-calculator-separate-permanent-and-dynamic-content",
        "when-calculator-validate-editorial-depth-and-visible-faq",
        "when-calculator-resolve-canonical-recommendation-slot",
        "when-calculator-declare-adaptive-report-from-calculator-contract",
        "when-calculator-decide-conditional-modules-and-distinct-actions",
        "when-calculator-prepare-experience-plan",
        "when-calculator-pass-reference-study-complete",
        "when-calculator-pass-calculator-experience-plan-approved",
        "when-calculator-pass-result-contract-resolved",
        "when-calculator-pass-brand-theme-resolved",
        "when-calculator-pass-visible-updated-at-resolved",
        "when-calculator-pass-editorial-depth-resolved",
        "when-calculator-pass-recommendation-slot-resolved",
        "when-calculator-pass-adaptive-report-contract-resolved",
        "when-calculator-pass-report-render-validated",
        "when-article-resolve-primary-search-intent-and-reader-action",
        "when-article-prepare-plain-language-section-flow-example-and-repetition-plan",
        "when-article-classify-update-sensitivity-and-mutable-sections",
        "when-article-map-official-sources-rules-assets-and-dependencies",
        "when-article-resolve-domain-nucleus-cluster-pillar-and-role",
        "when-article-prepare-contextual-continuity-and-discovery-links",
        "when-article-evaluate-inbound-links-and-orphan-risk",
        "when-article-pass-search-intent-resolved",
        "when-article-pass-editorial-clarity-resolved",
        "when-article-pass-content-freshness-resolved",
        "when-article-pass-official-sources-resolved",
        "when-article-pass-cluster-position-resolved",
        "when-article-pass-internal-link-plan-resolved",
        "when-article-pass-bidirectional-cluster-linking-resolved",
        "provision-draft-specification",
        "prepare-relationship-map",
        "register-registry-draft",
        "prepare-testing-plan",
        "prepare-validation-plan",
        "prepare-publishing-draft",
        "prepare-rollback",
        "generate-reports"
      ],
      "approvalRequired": true,
      "rollbackRequired": true,
      "publishingMaximumLifecycle": "draft",
      "runtimeStatus": "not-consumed"
    }
  ],
  "selectionRules": {
    "selectBy": "assetType",
    "usesConfiguration": "/data/manifests/operations/asset/index.json#assetTypeResolution",
    "usesInference": false,
    "calculatorContract": "/data/blueprints/contracts/calculator-experience.contract.json",
    "calculatorSpecificStepsApplyWhen": "assetType=calculator AND compatibility class is NEW_ASSET or MIGRATED_ASSET",
    "legacyCalculatorPolicy": "LEGACY_ACCEPTED_PENDING_MIGRATION",
    "articleContract": "/data/blueprints/article/editorial-automation.contract.json",
    "articleSpecificStepsApplyWhen": "assetType=article AND compatibility class is NEW_ARTICLE or MIGRATED_ARTICLE",
    "legacyArticlePolicy": "LEGACY_ACCEPTED_PENDING_MIGRATION"
  }
}
