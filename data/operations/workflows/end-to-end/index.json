{
  "id": "end-to-end-operation-workflows",
  "version": "0.4.0",
  "schema": "/data/operations/schemas/workflow.schema.json",
  "status": "foundation",
  "runtimeStatus": "consumed-by-asset-automation",
  "createdAt": "2026-07-12",
  "updatedAt": "2026-07-14",
  "owner": "Calcule Trabalhador",
  "source": "Operational Capabilities Phase 5.16 - End-to-End Automation Workflow",
  "description": "Official ordered workflow for deliver-asset-end-to-end. It defines orchestration states only and does not execute operations.",
  "workflows": [
    {
      "workflowId": "deliver-asset-end-to-end-workflow",
      "operationId": "deliver-asset-end-to-end",
      "defaultMode": "DRY_RUN",
      "approvalRequired": true,
      "rollbackRequired": true,
      "runtimeStatus": "consumed-by-calculator-automation",
      "steps": [
        {
          "id": "REQUEST_INTAKE",
          "input": ["manifest", "user-request"],
          "output": ["normalized-request"],
          "preconditions": ["request-type-supported"],
          "gates": ["required-fields-present"],
          "stopConditions": ["unsupported-request-type"],
          "rollback": "none",
          "nextStates": ["PREFLIGHT"]
        },
        {
          "id": "PREFLIGHT",
          "input": ["normalized-request"],
          "output": ["preflight-report"],
          "preconditions": ["git-status-readable"],
          "gates": ["working-tree-audit", "secret-scan", "json-valid", "internal-json-refs-valid"],
          "stopConditions": ["working-tree-collision", "secret-detected", "json-invalid", "refs-invalid"],
          "rollback": "none",
          "nextStates": ["SCOPE_RESOLUTION"]
        },
        {
          "id": "SCOPE_RESOLUTION",
          "input": ["normalized-request", "preflight-report"],
          "output": ["execution-scope-plan"],
          "preconditions": ["preflight-pass-or-warning"],
          "gates": ["required-vs-not-applicable-classified"],
          "stopConditions": ["scope-ambiguous"],
          "rollback": "none",
          "nextStates": ["GOVERNANCE_RESOLUTION"]
        },
        {
          "id": "GOVERNANCE_RESOLUTION",
          "input": ["execution-scope-plan"],
          "output": ["governance-resolution"],
          "preconditions": ["typed-identity-policy-loaded"],
          "gates": ["assetId", "assetType", "blueprint", "gold-standard", "reference", "owner"],
          "stopConditions": ["identity-missing", "blueprint-missing", "gold-standard-missing", "reference-critical-missing"],
          "rollback": "none",
          "nextStates": ["CALCULATOR_EXPERIENCE_RESOLUTION", "ARTICLE_AUTOMATION_RESOLUTION", "REUSE_OR_CREATE_DECISION"]
        },
        {
          "id": "CALCULATOR_EXPERIENCE_RESOLUTION",
          "appliesWhen": ["assetType=calculator", "assetCompatibilityClass=NEW_ASSET-or-MIGRATED_ASSET"],
          "legacyBehavior": "LEGACY_ACCEPTED_PENDING_MIGRATION bypasses new-standard certification unless migration is requested",
          "input": ["governance-resolution", "calculator-experience-contract", "official-reference"],
          "output": ["reference-study", "module-decomposition", "calculator-experience-plan", "result-contract-resolution", "brand-theme-resolution", "visible-updated-at-resolution", "editorial-depth-resolution", "recommendation-slot-resolution", "adaptive-report-resolution", "report-render-plan", "visual-validation-plan"],
          "preconditions": ["calculator-blueprint-resolved", "calculator-gold-standard-resolved", "official-reference-resolved", "physical-reference-readable"],
          "gates": ["REFERENCE_STUDY_COMPLETE", "CALCULATOR_EXPERIENCE_PLAN_APPROVED", "RESULT_CONTRACT_RESOLVED", "BRAND_THEME_RESOLVED", "VISIBLE_UPDATED_AT_RESOLVED", "EDITORIAL_DEPTH_RESOLVED", "RECOMMENDATION_SLOT_RESOLVED", "ADAPTIVE_REPORT_CONTRACT_RESOLVED"],
          "stopConditions": ["reference-declared-but-not-studied", "module-decomposition-missing", "literal-copy-risk", "form-class-unresolved", "result-class-unresolved", "memory-level-unresolved", "unapproved-primary-theme", "visible-updated-at-unresolved", "editorial-depth-unresolved", "permanent-content-hidden-before-calculation", "recommendation-slot-unresolved", "adaptive-report-unresolved", "conditional-modules-undecided", "calculator-experience-plan-not-approved"],
          "rollback": "discard-calculator-experience-draft-evidence",
          "nextStates": ["REUSE_OR_CREATE_DECISION"]
        },
        {
          "id": "ARTICLE_AUTOMATION_RESOLUTION",
          "appliesWhen": ["assetType=article", "articleCompatibilityClass=NEW_ARTICLE-or-MIGRATED_ARTICLE"],
          "legacyBehavior": "LEGACY_ACCEPTED_PENDING_MIGRATION bypasses new-standard certification unless migration is explicitly requested",
          "input": ["governance-resolution", "article-editorial-automation-contract", "article-reference-evidence"],
          "output": ["search-intent-resolution", "article-editorial-plan", "freshness-resolution", "source-traceability-map", "cluster-position-resolution", "internal-link-plan", "bidirectional-link-resolution", "panel-metadata-minimum"],
          "preconditions": ["article-blueprint-resolved", "article-gold-standard-resolved", "article-editorial-contract-resolved"],
          "gates": ["SEARCH_INTENT_RESOLVED", "EDITORIAL_CLARITY_RESOLVED", "CONTENT_FRESHNESS_RESOLVED", "OFFICIAL_SOURCES_RESOLVED", "CLUSTER_POSITION_RESOLVED", "INTERNAL_LINK_PLAN_RESOLVED", "BIDIRECTIONAL_CLUSTER_LINKING_RESOLVED"],
          "stopConditions": ["topic-covered-but-intent-not-resolved", "blocker-editorial-anti-pattern", "freshness-classification-missing", "mandatory-official-source-missing", "cluster-or-pillar-unresolved", "new-non-pillar-article-without-pillar-link", "inbound-link-analysis-missing", "orphan-risk-unresolved"],
          "rollback": "discard-article-automation-draft-evidence",
          "nextStates": ["REUSE_OR_CREATE_DECISION"]
        },
        {
          "id": "REUSE_OR_CREATE_DECISION",
          "input": ["governance-resolution"],
          "output": ["reuse-create-decision"],
          "preconditions": ["registries-readable", "catalogs-readable"],
          "gates": ["duplicates-checked", "physical-destination-checked"],
          "stopConditions": ["duplicate-identity", "slug-conflict", "url-conflict"],
          "rollback": "none",
          "nextStates": ["RELATIONSHIP_RESOLUTION"]
        },
        {
          "id": "RELATIONSHIP_RESOLUTION",
          "input": ["reuse-create-decision"],
          "output": ["relationship-plan"],
          "preconditions": ["typed-asset-ids-available"],
          "gates": ["candidate-review-approval-flow"],
          "stopConditions": ["unapproved-relationship"],
          "rollback": "remove-unapproved-candidates-from-plan",
          "nextStates": ["ASSET_PROVISIONING"]
        },
        {
          "id": "ASSET_PROVISIONING",
          "input": ["relationship-plan"],
          "output": ["asset-provisioning-plan"],
          "preconditions": ["create-asset-manifest-available"],
          "gates": ["registry-draft", "publishing-draft", "testing-plan", "validation-plan"],
          "stopConditions": ["provisioning-plan-invalid"],
          "rollback": "discard-internal-draft-artifacts",
          "nextStates": ["PHYSICAL_PLAN"]
        },
        {
          "id": "PHYSICAL_PLAN",
          "input": ["asset-provisioning-plan"],
          "output": ["physical-plan"],
          "preconditions": ["allowed-files-resolved"],
          "gates": ["physical-destination", "visual-pattern", "expected-diff", "rollback-plan"],
          "stopConditions": ["unknown-destination", "unresolved-pattern", "public-file-not-allowed"],
          "rollback": "none",
          "nextStates": ["SNAPSHOT"]
        },
        {
          "id": "SNAPSHOT",
          "input": ["physical-plan"],
          "output": ["snapshot-record"],
          "preconditions": ["target-files-readable"],
          "gates": ["checksum-captured"],
          "stopConditions": ["snapshot-failed"],
          "rollback": "restore-from-snapshot-record-only-when-approved",
          "nextStates": ["PHYSICAL_EXECUTION"]
        },
        {
          "id": "PHYSICAL_EXECUTION",
          "input": ["snapshot-record", "physical-plan"],
          "output": ["physical-diff"],
          "preconditions": ["execution-mode-allows-write", "manual-approval-when-required"],
          "gates": ["diff-minimal", "allowed-files-only"],
          "stopConditions": ["dry-run", "approval-missing", "unexpected-diff"],
          "rollback": "file-level-rollback-from-snapshot",
          "nextStates": ["PUBLIC_CATALOG_UPDATE"]
        },
        {
          "id": "PUBLIC_CATALOG_UPDATE",
          "input": ["physical-diff"],
          "output": ["catalog-change-plan"],
          "preconditions": ["catalog-update-applicable"],
          "gates": ["catalog-format-preserved", "no-duplicates"],
          "stopConditions": ["catalog-conflict"],
          "rollback": "catalog-entry-rollback",
          "nextStates": ["PUBLIC_DISTRIBUTION"]
        },
        {
          "id": "PUBLIC_DISTRIBUTION",
          "input": ["catalog-change-plan"],
          "output": ["distribution-plan"],
          "preconditions": ["distribution-applicable"],
          "gates": ["home", "blog", "tools", "category", "guide"],
          "stopConditions": ["distribution-approval-missing"],
          "rollback": "runtime-projection-rollback",
          "nextStates": ["LINKS_AND_METADATA"]
        },
        {
          "id": "LINKS_AND_METADATA",
          "input": ["distribution-plan"],
          "output": ["links-metadata-plan"],
          "preconditions": ["relationships-approved"],
          "gates": ["cta-no-duplicates", "json-ld-valid", "canonical-valid", "breadcrumb-valid"],
          "stopConditions": ["metadata-invalid", "cta-duplicate"],
          "rollback": "links-and-metadata-rollback",
          "nextStates": ["SITEMAP_PLAN"]
        },
        {
          "id": "SITEMAP_PLAN",
          "input": ["links-metadata-plan"],
          "output": ["sitemap-plan"],
          "preconditions": ["physical-page-and-canonical-valid"],
          "gates": ["no-duplicate-url", "lastmod-evidence"],
          "stopConditions": ["sitemap-conflict"],
          "rollback": "sitemap-entry-rollback",
          "nextStates": ["TESTING"]
        },
        {
          "id": "TESTING",
          "input": ["sitemap-plan"],
          "output": ["testing-report"],
          "preconditions": ["tests-selected-by-scope"],
          "gates": ["critical-tests-pass-or-not-applicable", "calculator-negative-standard-tests-pass-when-applicable", "article-contract-fixtures-pass-when-applicable", "result-action-functionality-tests-pass-when-applicable"],
          "stopConditions": ["critical-test-failed"],
          "rollback": "none",
          "nextStates": ["VALIDATION"]
        },
        {
          "id": "VALIDATION",
          "input": ["testing-report"],
          "output": ["validation-report"],
          "preconditions": ["validation-selected-by-scope"],
          "gates": ["critical-validations-pass-or-not-applicable", "ANTI_PATTERN_GATE", "CONTENT_DEPTH_GATE", "SEARCH_INTENT_RESOLVED", "EDITORIAL_CLARITY_RESOLVED", "CONTENT_FRESHNESS_RESOLVED", "OFFICIAL_SOURCES_RESOLVED", "CLUSTER_POSITION_RESOLVED", "INTERNAL_LINK_PLAN_RESOLVED", "BIDIRECTIONAL_CLUSTER_LINKING_RESOLVED", "REPORT_RENDER_VALIDATED", "result-experience-validation-resolved", "accessibility-validation-resolved"],
          "stopConditions": ["critical-validation-failed", "applicable-blocker-anti-pattern", "result-experience-invalid", "report-render-invalid", "result-actions-not-distinct", "article-gate-unresolved"],
          "rollback": "none",
          "nextStates": ["PREVIEW"]
        },
        {
          "id": "PREVIEW",
          "input": ["validation-report"],
          "output": ["preview-or-diff-evidence"],
          "preconditions": ["preview-required-when-public-impact"],
          "gates": ["reviewable-output", "visual-status-is-explicit", "required-viewports-evidenced-or-manual-visual-approval-requested"],
          "stopConditions": ["preview-unavailable-for-public-impact", "false-visual-pass", "visual-validation-not-executed-claimed-as-full-standard"],
          "rollback": "none",
          "nextStates": ["MANUAL_APPROVAL"]
        },
        {
          "id": "MANUAL_APPROVAL",
          "input": ["preview-or-diff-evidence"],
          "output": ["approval-record"],
          "preconditions": ["approval-required-by-scope"],
          "gates": ["approvedBy", "approvedScope", "approvedFiles", "approvedUrls", "approvedAt", "VISUAL_VALIDATION_STATUS_RESOLVED-when-new-or-migrated-calculator"],
          "stopConditions": ["approval-missing"],
          "rollback": "none",
          "nextStates": ["PUBLICATION_CONFIRMATION"]
        },
        {
          "id": "PUBLICATION_CONFIRMATION",
          "input": ["approval-record"],
          "output": ["publication-confirmation"],
          "preconditions": ["all-gates-pass"],
          "gates": ["rollback-ready"],
          "stopConditions": ["rollback-unavailable"],
          "rollback": "none",
          "nextStates": ["SITEMAP_EXECUTION"]
        },
        {
          "id": "SITEMAP_EXECUTION",
          "input": ["publication-confirmation", "sitemap-plan"],
          "output": ["sitemap-change-report"],
          "preconditions": ["execution-mode-allows-publication"],
          "gates": ["xml-valid", "canonical-valid"],
          "stopConditions": ["dry-run", "sitemap-execution-not-approved"],
          "rollback": "sitemap-entry-rollback",
          "nextStates": ["INDEXNOW_DRY_RUN"]
        },
        {
          "id": "INDEXNOW_DRY_RUN",
          "input": ["sitemap-change-report"],
          "output": ["indexnow-dry-run-report"],
          "preconditions": ["published-url-valid"],
          "gates": ["dry-run-success"],
          "stopConditions": ["indexnow-dry-run-failed"],
          "rollback": "none",
          "nextStates": ["OPTIONAL_INDEXNOW_SEND"]
        },
        {
          "id": "OPTIONAL_INDEXNOW_SEND",
          "input": ["indexnow-dry-run-report"],
          "output": ["indexnow-send-report"],
          "preconditions": ["explicit-indexnow-send-approval"],
          "gates": ["send-response-recorded"],
          "stopConditions": ["approval-missing"],
          "rollback": "none",
          "nextStates": ["FINAL_VALIDATION"]
        },
        {
          "id": "FINAL_VALIDATION",
          "input": ["operation-evidence"],
          "output": ["final-validation-report"],
          "preconditions": ["all-applicable-reports-available"],
          "gates": ["end-to-end-pass-or-warning"],
          "stopConditions": ["final-validation-failed"],
          "rollback": "operation-scope-rollback",
          "nextStates": ["PUBLICATION_LOG"]
        },
        {
          "id": "PUBLICATION_LOG",
          "input": ["final-validation-report"],
          "output": ["publication-log"],
          "preconditions": ["final-status-known"],
          "gates": ["affected-files-recorded", "checksums-recorded"],
          "stopConditions": ["log-write-unavailable"],
          "rollback": "none",
          "nextStates": ["ROLLBACK_AVAILABLE"]
        },
        {
          "id": "ROLLBACK_AVAILABLE",
          "input": ["publication-log"],
          "output": ["rollback-record"],
          "preconditions": ["rollback-required"],
          "gates": ["rollback-by-asset", "rollback-by-file", "rollback-by-operation", "rollback-full-batch"],
          "stopConditions": ["rollback-unavailable"],
          "rollback": "available",
          "nextStates": []
        }
      ]
    }
  ]
}
