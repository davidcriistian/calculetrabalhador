{
  "id": "end-to-end-operation-playbooks",
  "version": "0.4.0",
  "schema": "/data/operations/schemas/playbook.schema.json",
  "status": "foundation",
  "runtimeStatus": "consumed-by-asset-automation",
  "createdAt": "2026-07-12",
  "updatedAt": "2026-07-14",
  "owner": "Calcule Trabalhador",
  "source": "Operational Capabilities Phase 5.16 - End-to-End Automation Workflow",
  "description": "Playbook for deliver-asset-end-to-end. It coordinates existing capabilities and stops when scope, governance or approval is missing.",
  "playbooks": [
    {
      "operationId": "deliver-asset-end-to-end",
      "objective": "Convert a user request into a governed, deterministic, reversible execution plan and execute only approved applicable phases.",
      "minimumInputs": [
        "operationId",
        "requestType",
        "objective",
        "assetScope",
        "assetTypes",
        "manualApprovalRequired",
        "rollbackRequired",
        "dryRun"
      ],
      "defaultMode": "DRY_RUN",
      "preconditions": [
        "working-tree-audited",
        "secret-scan-pass",
        "json-valid",
        "internal-json-refs-valid",
        "request-type-supported",
        "operation-permissions-resolved",
        "rollback-required"
      ],
      "decisionSequence": [
        "classify-request-type",
        "resolve-scope-plan",
        "resolve-governance-for-each-asset",
        "for-new-or-migrated-calculator-open-and-study-official-physical-reference",
        "for-new-or-migrated-calculator-decompose-reference-modules-without-literal-copy",
        "for-new-or-migrated-calculator-resolve-institutional-theme-and-governed-visible-updated-at",
        "for-new-or-migrated-calculator-classify-form-result-and-memory",
        "for-new-or-migrated-calculator-separate-permanent-and-dynamic-content",
        "for-new-or-migrated-calculator-validate-editorial-depth-and-visible-faq",
        "for-new-or-migrated-calculator-resolve-canonical-recommendation-slot",
        "for-new-or-migrated-calculator-declare-adaptive-report-and-distinct-actions",
        "for-new-or-migrated-calculator-approve-experience-plan",
        "for-new-or-migrated-article-resolve-search-intent-reader-problem-and-action",
        "for-new-or-migrated-article-resolve-plain-language-flow-examples-and-repetition",
        "for-new-or-migrated-article-resolve-freshness-mutable-content-sources-and-impact",
        "for-new-or-migrated-article-resolve-cluster-pillar-role-and-bidirectional-links",
        "for-new-or-migrated-article-pass-seven-article-gates",
        "check-reuse-before-create",
        "classify-relationships",
        "select-existing-operation-capabilities",
        "select-physical-change-type",
        "select-public-distribution-targets",
        "select-testing-layers",
        "select-validation-layers",
        "select-approval-gates",
        "select-rollback-shape"
      ],
      "physicalChangeTypes": [
        "EXISTING_PAGE_CONTROLLED_UPDATE",
        "NEW_PAGE_GENERATION",
        "CATALOG_ONLY_UPDATE",
        "CONFIGURATION_ONLY_UPDATE",
        "NO_PUBLIC_CHANGE_REQUIRED",
        "MANUAL_DECISION_REQUIRED"
      ],
      "publicCatalogRules": {
        "calculator": "Use data/tools.json only when a calculator page is approved for catalog publication.",
        "article": "Use data/articles.json only when an article page is approved for catalog publication.",
        "guideOrNucleus": "Use data/brain/nuclei.json only when the current runtime projection requires it.",
        "rule": "Do not copy PAM into public catalogs."
      },
      "distributionRules": {
        "tools": "Tools page follows data/tools.json; Home exposure requires explicit showOnHome approval.",
        "blog": "Blog follows data/articles.json; category exposure requires approved projection.",
        "guide": "Guide page generation and Home exposure require governed Guide/Nucleus projection.",
        "category": "Use deterministic articleFilter; do not use title keyword heuristics.",
        "sitemap": "Add URL only after physical page and canonical are valid.",
        "indexnow": "Dry-run first; send only after explicit approval."
      },
      "linkAndCtaRules": {
        "calculator": "Use contextual links only when approved.",
        "pillarArticle": "CTA to calculator and satellite links only when approved.",
        "satelliteArticle": "CTA to calculator at approved beginning, middle and final positions without duplicates.",
        "guide": "Links to calculator, pillar and satellites only when relationships are approved."
      },
      "schemaRules": {
        "calculator": ["SoftwareApplication when applicable", "FAQPage only with real FAQ", "BreadcrumbList"],
        "article": ["Article", "FAQPage only with real FAQ", "BreadcrumbList"],
        "guide": ["CollectionPage", "FAQPage only with real FAQ", "BreadcrumbList"],
        "category": ["CollectionPage", "BreadcrumbList"],
        "prohibited": ["empty schema", "nonexistent URL", "canonical mismatch", "FAQPage without FAQ", "broken breadcrumb"]
      },
      "testingPolicy": {
        "statuses": ["PASS", "FAIL", "WARNING", "NOT_APPLICABLE", "NOT_AVAILABLE"],
        "rule": "Do not mark a test PASS when it was not executed.",
        "calculatorNegativeFixtures": "/data/pos/validation/calculator-experience-fixtures.json",
        "calculatorValidator": "/scripts/validate-calculator-experience-contract.js"
        ,"articleFixtures": "/data/pos/validation/article-automation-fixtures.json"
        ,"articleValidator": "/scripts/validate-article-automation.js"
      },
      "calculatorExperiencePolicy": {
        "contract": "/data/blueprints/contracts/calculator-experience.contract.json",
        "appliesTo": ["NEW_ASSET", "MIGRATED_ASSET"],
        "legacyPolicy": "LEGACY_ACCEPTED_PENDING_MIGRATION",
        "generationPrerequisites": ["REFERENCE_STUDY_COMPLETE", "CALCULATOR_EXPERIENCE_PLAN_APPROVED", "RESULT_CONTRACT_RESOLVED", "BRAND_THEME_RESOLVED", "VISIBLE_UPDATED_AT_RESOLVED", "EDITORIAL_DEPTH_RESOLVED", "RECOMMENDATION_SLOT_RESOLVED", "ADAPTIVE_REPORT_CONTRACT_RESOLVED"],
        "fullStandardPrerequisites": ["VISUAL_VALIDATION_STATUS_RESOLVED", "REPORT_RENDER_VALIDATED"],
        "visualStatuses": ["VISUAL_VALIDATION_PASSED", "VISUAL_VALIDATION_FAILED", "VISUAL_VALIDATION_NOT_EXECUTED", "VISUAL_APPROVAL_REQUIRED"],
        "notExecutedRule": "VISUAL_VALIDATION_NOT_EXECUTED cannot become FULL_STANDARD_ACCEPTED",
        "requiredVisualEvidence": ["small-mobile", "large-mobile", "intermediate", "desktop"],
        "recommendationRule": "Keep CANONICAL_RESULT_RECOMMENDATION_SLOT after interpretation and before memory; render approved product only in CONFIGURED_ELIGIBLE, otherwise hide.",
        "reportRule": "Derive seven adaptive report declarations from calculator semantics; use an isolated A4 selectable report and distinct copy, print and download behaviors.",
        "literalCopyProhibited": true
      },
      "articleAutomationPolicy": {
        "contract": "/data/blueprints/article/editorial-automation.contract.json",
        "appliesTo": ["NEW_ARTICLE", "MIGRATED_ARTICLE"],
        "legacyPolicy": "LEGACY_ACCEPTED_PENDING_MIGRATION",
        "generationPrerequisites": ["SEARCH_INTENT_RESOLVED", "EDITORIAL_CLARITY_RESOLVED", "CONTENT_FRESHNESS_RESOLVED", "OFFICIAL_SOURCES_RESOLVED", "CLUSTER_POSITION_RESOLVED", "INTERNAL_LINK_PLAN_RESOLVED", "BIDIRECTIONAL_CLUSTER_LINKING_RESOLVED"],
        "freshnessClasses": ["EVERGREEN", "TIME_SENSITIVE", "LEGAL_RULE_DEPENDENT", "OFFICIAL_TABLE_DEPENDENT", "PROCEDURE_DEPENDENT", "MIXED"],
        "linkTypes": ["CONTEXTUAL_LINK", "CONTINUITY_LINK", "DISCOVERY_BLOCK_LINK"],
        "heuristicsMustBeLabeled": true,
        "panelImplementationIncluded": false,
        "literalCopyProhibited": true
      },
      "approvalPolicy": {
        "requiresManualApprovalFor": [
          "new-page",
          "visual-change",
          "new-url",
          "seo-change",
          "calculation-change",
          "legal-change",
          "home-change",
          "category-change",
          "sitemap-change",
          "indexnow-send",
          "batch-migration"
        ],
        "approvalFields": [
          "approvedBy",
          "approvedScope",
          "approvedFiles",
          "approvedUrls",
          "approvedAt",
          "excludedScope"
        ]
      },
      "idempotencyRules": [
        "Check current state before creating.",
        "Do not duplicate asset, card, catalog entry, relationship, CTA, sitemap URL or publication report.",
        "Return SKIPPED_ALREADY_COMPLIANT when the requested state already exists."
      ],
      "stopConditions": [
        "working-tree-collision",
        "duplicate-identity",
        "slug-conflict",
        "url-conflict",
        "unapproved-relationship",
        "unknown-destination",
        "unresolved-pattern",
        "unvalidated-calculation",
        "missing-critical-reference",
        "missing-blueprint",
        "missing-gold-standard",
        "reference-study-incomplete",
        "calculator-experience-plan-not-approved",
        "result-contract-unresolved",
        "brand-theme-unresolved",
        "visible-updated-at-unresolved",
        "editorial-depth-unresolved",
        "recommendation-slot-unresolved",
        "adaptive-report-contract-unresolved",
        "report-render-invalid",
        "applicable-blocker-anti-pattern",
        "false-visual-pass",
        "unapproved-calculator-recommendation",
        "article-search-intent-unresolved",
        "article-editorial-clarity-unresolved",
        "article-freshness-unresolved",
        "article-official-sources-unresolved",
        "article-cluster-position-unresolved",
        "article-internal-link-plan-unresolved",
        "article-bidirectional-linking-unresolved",
        "critical-test-failed",
        "critical-validation-failed",
        "rollback-unavailable",
        "required-human-decision-missing"
      ],
      "forbiddenActions": [
        "blindly-run-all-phases",
        "create-new-engine",
        "duplicate-create-asset-logic",
        "hardcode-home-card",
        "keyword-based-category-filter",
        "format-entire-public-file",
        "modify-global-css-js-without-scope",
        "publish-without-approval",
        "indexnow-send-without-approval"
      ],
      "outputs": [
        "executionScopePlan",
        "governanceResolution",
        "reuseCreateDecision",
        "relationshipPlan",
        "physicalPlan",
        "testingPlan",
        "validationPlan",
        "approvalRecord",
        "rollbackPlan",
        "consolidatedReport"
        ,"referenceStudy"
        ,"moduleDecomposition"
        ,"calculatorExperiencePlan"
        ,"resultContractResolution"
        ,"brandThemeResolution"
        ,"visibleUpdatedAtResolution"
        ,"editorialDepthResolution"
        ,"recommendationSlotResolution"
        ,"adaptiveReportResolution"
        ,"reportRenderValidation"
        ,"visualValidationStatus"
      ]
    }
  ],
  "duplicationAudit": {
    "createAsset": "referenced-not-duplicated",
    "nucleusOperations": "referenced-not-duplicated",
    "manifestSystem": "extended-by-partition",
    "publishing": "referenced-not-reimplemented",
    "testing": "referenced-not-reimplemented",
    "validation": "referenced-not-reimplemented",
    "rollback": "report-template-only",
    "runtimeMapping": "uses-existing-evidence-and-contracts"
  }
}
