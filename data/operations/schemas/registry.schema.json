{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "/data/operations/schemas/registry.schema.json",
  "title": "Operation Registry",
  "allOf": [
    { "$ref": "/data/operations/schemas/operation.schema.json" },
    {
      "type": "object",
      "required": ["references", "operationalBoundaries"],
      "properties": {
        "references": { "type": "object", "additionalProperties": { "type": "string" } },
        "operationalBoundaries": { "type": "object", "additionalProperties": { "type": "boolean" } }
      }
    }
  ]
}
