  "calculationSpec": {
    "inputs": ["custosEmpresa", "despesasPessoais", "tributosMensais", "outrosEssenciais", "mesesCobertura", "pausaPlanejada", "custosAnuais", "reservaAtual", "aporteMensal"],
    "normalization": ["empty input becomes numeric zero", "decimal comma is accepted by the local parser", "money is rounded to centavos", "negative and non-finite values are rejected"],
    "validations": ["all numeric inputs are finite and non-negative", "monthly essential base is greater than zero", "coverage is one of 3, 6, 9 or 12 months"],
    "formulas": [
      "baseMensal = custosEmpresa + despesasPessoais + tributosMensais + outrosEssenciais",
      "reservaSeguranca = baseMensal * mesesCobertura",
      "valoresPlanejados = pausaPlanejada + custosAnuais",
      "metaTotal = reservaSeguranca + valoresPlanejados",
      "valorFaltante = max(0, metaTotal - reservaAtual)",
      "excedente = max(0, reservaAtual - metaTotal)",
      "coberturaAtual = reservaAtual / baseMensal",
      "progresso = min(100, reservaAtual / metaTotal * 100)",
      "mesesPrazo = ceil(valorFaltante / aporteMensal) when aporteMensal > 0",
      "scenario targets repeat the same formula for 3, 6, 9 and 12 months"
    ],
    "outputs": ["monthly essential base", "selected target", "security reserve", "planned values", "gap or surplus", "current gross coverage", "progress percentage", "linear time estimate", "four-scenario comparison"],
