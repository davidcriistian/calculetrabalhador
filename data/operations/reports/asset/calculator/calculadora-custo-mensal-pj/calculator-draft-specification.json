  "calculationSpec": {
    "inputs": ["faturamento","impostos","proLabore","inss","contabilidade","banco","ferramentas","outras","saude","alimentacao","ferias","emergencia"],
    "normalization": ["empty input becomes numeric zero", "decimal comma is accepted by the local parser", "negative and non-finite values are rejected"],
    "validations": ["faturamento > 0", "all inputs finite and >= 0", "impostos, ferias and emergencia individually < 100", "impostos + ferias + emergencia < 100", "0 <= inss <= 100"],
    "formulas": [
      "tributos = faturamento * impostos / 100",
      "inssValor = proLabore * inss / 100",
      "empresa = contabilidade + banco + ferramentas + outras",
      "beneficios = saude + alimentacao",
      "reservas = faturamento * (ferias + emergencia) / 100",
      "total = tributos + proLabore + inssValor + empresa + beneficios + reservas",
      "disponivel = faturamento - total",
      "fixos = proLabore + inssValor + empresa + beneficios",
      "equilibrio = fixos / (1 - (impostos + ferias + emergencia) / 100)",
      "peso = total / faturamento * 100"
    ],
    "outputs": ["total","disponivel","peso","equilibrio","component breakdown"],
    "rounding": "Each monetary component is rounded to centavos before aggregation; totals and point of equilibrium are also rounded to centavos, and rendered with Intl.NumberFormat.",
    "assumptions": ["ferias and decimo-terceiro reserve default of 16.67% is an editable business-planning reference", "emergency reserve default of 5% is editable", "pro-labore is shown as committed cash outflow", "point of equilibrium assumes the entered percentages remain constant"],
