  "calculationSpec": {
    "inputs": ["diasFerias","mesesAteFerias","rendaPessoal","custosFixos","receitaRecorrente","gastosExtras","reservaAtual","faturamentoMensal"],
    "normalization": ["decimal comma accepted by the page parser","money rounded to centavos","negative and non-finite values rejected"],
    "validations": ["days and months are integers from 1 to 60","monthly revenue is greater than zero","at least one coverage need is greater than zero"],
    "formulas": [
      "factor = vacationDays / 30",
      "personalCoverage = desiredPersonalIncome * factor",
      "businessCoverage = fixedBusinessCosts * factor",
      "maintainedRevenue = recurringMonthlyRevenue * factor",
      "grossCost = personalCoverage + businessCoverage + extraVacationCosts",
      "netTarget = max(0, grossCost - maintainedRevenue)",
      "gap = max(0, netTarget - currentVacationReserve)",
      "monthlyContribution = gap / monthsUntilVacation",
      "revenueWeight = monthlyContribution / averageMonthlyRevenue * 100"
    ],
    "outputs": ["net vacation target","gross pause cost","maintained revenue","gap","monthly contribution","revenue weight","progress","7/15/20/30-day comparison"],
    "rounding": "Monetary intermediates are rounded to two decimals and the displayed percentage uses one decimal.",
    "assumptions": ["30-day month is a planning convention","all financial premises come from user input","extra costs are total rather than prorated","comparison scenarios preserve extra costs and time horizon"],
    "limitations": ["no CLT vacation rule is applied","no contractual revenue is guaranteed","no tax table is applied","no return, inflation or future cash-flow variation is modeled"]
  },
