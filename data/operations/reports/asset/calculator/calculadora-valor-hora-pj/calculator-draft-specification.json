  "calculationSpec": {
    "inputs": [
      "rendaDesejada",
      "custosMensais",
      "impostosPercentual",
      "reservaPercentual",
      "horasSemana",
      "semanasMes",
      "horasDia",
      "horasProjeto"
    ],
    "formula": [
      "baseLiquida = rendaDesejada + custosMensais",
      "percentualTotal = impostosPercentual + reservaPercentual",
      "faturamentoMensal = baseLiquida / (1 - percentualTotal / 100)",
      "horasMes = horasSemana * semanasMes",
      "valorHora = faturamentoMensal / horasMes",
      "valorDia = valorHora * horasDia",
      "valorProjeto = valorHora * horasProjeto"
    ],
    "blockedConditions": [
      "rendaDesejada <= 0",
      "horasMes <= 0",
      "impostosPercentual + reservaPercentual >= 100"
    ],
    "ruleSources": [
      "User-provided financial assumptions",
      "Arithmetic only; no official tax table or legal rate embedded"
    ]
