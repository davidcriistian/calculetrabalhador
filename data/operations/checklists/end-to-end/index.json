{
  "id": "end-to-end-operation-checklists",
  "version": "0.4.0",
  "schema": "/data/operations/schemas/checklist.schema.json",
  "status": "foundation",
  "runtimeStatus": "consumed-by-asset-automation",
  "createdAt": "2026-07-12",
  "updatedAt": "2026-07-14",
  "owner": "Calcule Trabalhador",
  "source": "Operational Capabilities Phase 5.16 - End-to-End Automation Workflow",
  "description": "Checklist for scoped end-to-end asset delivery. Items are declarative and do not execute operations.",
  "before": [
    "confirm-request-type",
    "confirm-execution-mode-defaults-to-dry-run",
    "run-git-working-tree-audit",
    "classify-modified-files-and-collisions",
    "scan-for-secrets-and-unsafe-files",
    "validate-json",
    "validate-internal-json-references",
    "confirm-source-of-truth-files",
    "confirm-typed-asset-identity",
    "confirm-slug-url-and-physical-destination",
    "confirm-rollback-requirements"
  ],
  "scope": [
    "classify-each-capability-as-required-optional-not-applicable-blocked-or-manual-decision",
    "reuse-before-create-for-domain-nucleus-guide-cluster-calculator-article-product-cta-page-catalog-relationship-sitemap",
    "block-when-required-governance-is-missing",
    "do-not-run-unnecessary-phases"
  ],
  "during": [
    "use-create-asset-for-asset-provisioning",
    "use-approved-relationship-flow",
    "touch-only-allowed-files",
    "generate-snapshot-before-public-change",
    "preserve-public-catalog-shape",
    "preserve-canonical-jsonld-breadcrumb-unless-in-scope",
    "avoid-hardcoded-home-cards",
    "avoid-keyword-category-filters",
    "dry-run-indexnow-before-send"
  ],
  "testing": [
    "pre-change-working-tree-identity-registry-destination-snapshot",
    "asset-structure-logic-links-seo-accessibility-responsiveness",
    "runtime-consumers-catalogs-home-blog-category-tools",
    "integration-navigation-cross-nucleus-duplicates-sitemap-fail-safe",
    "post-change-diff-checksum-rollback-final-validation",
    "mark-unexecuted-tests-not-available-or-not-applicable"
  ],
  "validation": [
    "constitution",
    "architecture-evolution-policy",
    "platform-architecture",
    "asset-identity-policy",
    "pam",
    "blueprints",
    "gold-standards",
    "references",
    "registry",
    "domain-relationship-model",
    "publishing",
    "seo",
    "accessibility",
    "responsiveness",
    "runtime",
    "rollback"
  ],
  "calculatorStandard": {
    "appliesTo": ["NEW_ASSET", "MIGRATED_ASSET"],
    "legacyPolicy": "LEGACY_ACCEPTED_PENDING_MIGRATION",
    "reference": ["reference-resolved", "physical-reference-studied", "modules-decomposed", "literal-copy-avoided", "REFERENCE_STUDY_COMPLETE-passed"],
    "entryExperience": ["context-clear", "hero-complete", "outputs-previewed", "primary-entry-cta-dominant", "simulator-transition-clear"],
    "brandAndFreshness": ["institutional-blue-primary-theme-or-approved-variation", "BRAND_THEME_RESOLVED-passed", "governed-UPDATED_AT-present", "visible-Atualizado-em-month-year-matches-metadata", "VISIBLE_UPDATED_AT_RESOLVED-passed"],
    "form": ["complexity-classified-and-justified", "semantic-grouping-proportional", "journey-adequate", "optional-fields-differentiated", "conditional-fields-resolved", "validation-near-context", "confirmation-present-when-applicable", "final-cta-dominant"],
    "result": ["result-class-defined-and-justified", "primary-result-dominant", "scenario-context-restated", "secondary-indicators-evaluated", "interpretation-present", "CANONICAL_RESULT_RECOMMENDATION_SLOT-after-interpretation-before-memory", "memory-level-adequate", "limitations-present", "next-steps-present", "RESULT_CONTRACT_RESOLVED-passed", "RECOMMENDATION_SLOT_RESOLVED-passed"],
    "actions": ["COPY_RESULT-short-summary", "PRINT_RESULT-isolated-adaptive-report", "DOWNLOAD_REPORT-approved-adaptive-document", "copy-print-download-distinct", "implemented-actions-functionally-tested", "REPORT_RENDER_VALIDATED-passed"],
    "adaptiveReport": ["seven-report-declarations-resolved", "declarations-derived-from-calculator-semantics", "A4-structured", "selectable-text", "viewport-independent", "navigation-and-seo-content-independent", "no-screenshot-or-raster-only-pattern", "ADAPTIVE_REPORT_CONTRACT_RESOLVED-passed"],
    "content": ["permanent-layer-visible-before-calculation", "editorial-main-word-count-between-800-and-1200-after-exclusions", "editorial-useful-specific-and-not-padded", "faq-visible-before-calculation", "faq-sufficient-and-schema-exact", "methodology-and-sources-compatible", "related-content-governed", "EDITORIAL_DEPTH_RESOLVED-passed"],
    "visual": ["design-system-parity-assessed", "responsive-parity-assessed", "small-mobile-checked", "large-mobile-checked", "intermediate-checked", "desktop-checked", "overflow-checked", "focus-states-checked", "VISUAL_VALIDATION_STATUS_RESOLVED-passed"],
    "recommendations": ["canonical-four-state-model", "configuration-state-resolved", "eligibility-verified", "approved-product-source-verified", "not-configured-and-not-eligible-hidden", "no-recommendation-invented"],
    "antiPatterns": ["no-applicable-blocker", "major-items-resolved-or-approved-exception"]
  },
  "articleStandard": {
    "appliesTo": ["NEW_ARTICLE", "MIGRATED_ARTICLE"],
    "legacyPolicy": "LEGACY_ACCEPTED_PENDING_MIGRATION",
    "intentAndAudience": ["primary-search-intent-declared", "primary-question-declared", "secondary-questions-declared", "reader-action-declared", "audience-problem-defined", "SEARCH_INTENT_RESOLVED-passed"],
    "editorial": ["plain-language-plan", "technical-terms-explained", "dense-paragraphs-reviewed", "dependent-section-transitions-planned", "complex-concepts-have-examples-or-justification", "artificial-repetition-reviewed", "EDITORIAL_CLARITY_RESOLVED-passed"],
    "freshness": ["update-sensitivity-classified", "review-dates-evidence-based-or-null", "mutable-sections-identified-when-mixed", "affected-rules-assets-and-dependencies-recorded", "CONTENT_FRESHNESS_RESOLVED-passed"],
    "sources": ["official-dependent-claims-mapped", "source-fields-complete", "sources-verified-or-review-state-explicit", "OFFICIAL_SOURCES_RESOLVED-passed"],
    "cluster": ["domain-resolved", "nucleus-resolved", "cluster-resolved-without-invention", "pillar-resolved", "article-role-resolved", "CLUSTER_POSITION_RESOLVED-passed"],
    "links": ["contextual-links-planned", "continuity-links-planned", "discovery-links-planned", "targets-exist", "anchors-descriptive", "pillar-link-present-when-required", "inbound-links-evaluated", "orphan-risk-evaluated", "INTERNAL_LINK_PLAN_RESOLVED-passed", "BIDIRECTIONAL_CLUSTER_LINKING_RESOLVED-passed"],
    "contentAndSeo": ["direct-answer-near-beginning", "single-h1", "canonical-resolved", "faq-visible-schema-exact", "cta-plan-resolved", "mobile-validation-planned"],
    "panelMetadata": ["minimum-fields-only", "no-equivalent-field-duplicates", "validation-status-resolved", "publication-status-resolved"],
    "validator": ["article-contract-valid", "fixtures-pass", "heuristics-labeled", "human-review-items-recorded"]
  },
  "after": [
    "record-consolidated-report",
    "record-created-updated-reused-skipped-assets",
    "record-public-catalog-runtime-sitemap-indexnow-impact",
    "record-manual-decisions-warnings-blockers",
    "confirm-rollback-by-asset-file-operation-and-batch",
    "confirm-no-unapproved-public-change"
