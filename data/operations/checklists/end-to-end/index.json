    "missing-required-gold-standard",
    "missing-critical-reference",
    "critical-test-failed",
    "critical-validation-failed",
    "rollback-unavailable",
    "manual-decision-required-and-not-provided"
    ,"calculator-reference-study-incomplete"
    ,"calculator-experience-plan-not-approved"
    ,"calculator-result-contract-unresolved"
    ,"calculator-brand-theme-unresolved"
    ,"calculator-visible-updated-at-unresolved"
    ,"calculator-editorial-depth-unresolved"
    ,"calculator-recommendation-slot-unresolved"
    ,"calculator-adaptive-report-unresolved"
    ,"calculator-report-render-invalid"
    ,"calculator-applicable-blocker-anti-pattern"
    ,"calculator-false-visual-pass"
    ,"calculator-recommendation-source-unapproved"
    ,"article-search-intent-unresolved"
    ,"article-editorial-clarity-unresolved"
    ,"article-freshness-unresolved"
    ,"article-official-sources-unresolved"
    ,"article-cluster-position-unresolved"
    ,"article-internal-link-plan-unresolved"
    ,"article-bidirectional-linking-unresolved"
  ]
