{
  "id": "end-to-end-operation-checklists",
  "version": "0.2.0",
  "schema": "/data/operations/schemas/checklist.schema.json",
  "status": "foundation",
  "runtimeStatus": "consumed-by-calculator-automation",
  "createdAt": "2026-07-12",
  "updatedAt": "2026-07-14",
  "owner": "Calcule Trabalhador",
  "source": "Operational Capabilities Phase 5.16 - End-to-End Automation Workflow",
  "description": "Checklist for scoped end-to-end asset delivery. Items are declarative and do not execute operations.",
  "before": [
    "confirm-request-type",
    "confirm-execution-mode-defaults-to-dry-run",
    "run-git-working-tree-audit",
    "classify-modified-files-and-collisions",
    "scan-for-secrets-and-unsafe-files",
    "validate-json",
    "validate-internal-json-references",
    "confirm-source-of-truth-files",
    "confirm-typed-asset-identity",
    "confirm-slug-url-and-physical-destination",
    "confirm-rollback-requirements"
  ],
  "scope": [
    "classify-each-capability-as-required-optional-not-applicable-blocked-or-manual-decision",
    "reuse-before-create-for-domain-nucleus-guide-cluster-calculator-article-product-cta-page-catalog-relationship-sitemap",
    "block-when-required-governance-is-missing",
    "do-not-run-unnecessary-phases"
  ],
  "during": [
    "use-create-asset-for-asset-provisioning",
    "use-approved-relationship-flow",
    "touch-only-allowed-files",
    "generate-snapshot-before-public-change",
    "preserve-public-catalog-shape",
    "preserve-canonical-jsonld-breadcrumb-unless-in-scope",
    "avoid-hardcoded-home-cards",
    "avoid-keyword-category-filters",
    "dry-run-indexnow-before-send"
  ],
  "testing": [
    "pre-change-working-tree-identity-registry-destination-snapshot",
    "asset-structure-logic-links-seo-accessibility-responsiveness",
    "runtime-consumers-catalogs-home-blog-category-tools",
    "integration-navigation-cross-nucleus-duplicates-sitemap-fail-safe",
    "post-change-diff-checksum-rollback-final-validation",
    "mark-unexecuted-tests-not-available-or-not-applicable"
  ],
  "validation": [
    "constitution",
    "architecture-evolution-policy",
    "platform-architecture",
    "asset-identity-policy",
    "pam",
    "blueprints",
    "gold-standards",
    "references",
    "registry",
    "domain-relationship-model",
    "publishing",
    "seo",
    "accessibility",
    "responsiveness",
    "runtime",
    "rollback"
  ],
  "calculatorStandard": {
    "appliesTo": ["NEW_ASSET", "MIGRATED_ASSET"],
    "legacyPolicy": "LEGACY_ACCEPTED_PENDING_MIGRATION",
    "reference": ["reference-resolved", "physical-reference-studied", "modules-decomposed", "literal-copy-avoided", "REFERENCE_STUDY_COMPLETE-passed"],
    "entryExperience": ["context-clear", "hero-complete", "outputs-previewed", "primary-entry-cta-dominant", "simulator-transition-clear"],
    "form": ["complexity-classified-and-justified", "semantic-grouping-proportional", "journey-adequate", "optional-fields-differentiated", "conditional-fields-resolved", "validation-near-context", "confirmation-present-when-applicable", "final-cta-dominant"],
    "result": ["result-class-defined-and-justified", "primary-result-dominant", "scenario-context-restated", "secondary-indicators-evaluated", "memory-level-adequate", "interpretation-present", "limitations-present", "next-steps-present", "RESULT_CONTRACT_RESOLVED-passed"],
    "actions": ["copy-evaluated", "print-evaluated", "download-report-evaluated", "implemented-actions-functionally-tested", "omissions-justified"],
    "content": ["guide-depth-adequate", "faq-sufficient-and-schema-consistent", "methodology-and-sources-compatible", "related-content-governed"],
    "visual": ["design-system-parity-assessed", "responsive-parity-assessed", "small-mobile-checked", "large-mobile-checked", "intermediate-checked", "desktop-checked", "overflow-checked", "focus-states-checked", "VISUAL_VALIDATION_STATUS_RESOLVED-passed"],
    "recommendations": ["configuration-state-resolved", "eligibility-verified", "approved-source-verified", "no-recommendation-invented"],
    "antiPatterns": ["no-applicable-blocker", "major-items-resolved-or-approved-exception"]
  },
  "after": [
    "record-consolidated-report",
    "record-created-updated-reused-skipped-assets",
    "record-public-catalog-runtime-sitemap-indexnow-impact",
    "record-manual-decisions-warnings-blockers",
    "confirm-rollback-by-asset-file-operation-and-batch",
    "confirm-no-unapproved-public-change"
  ],
  "blockedWhen": [
    "working-tree-collision",
    "secret-detected",
    "identity-duplicate",
    "slug-url-conflict",
    "unapproved-relationship",
    "missing-required-blueprint",
    "missing-required-gold-standard",
    "missing-critical-reference",
    "critical-test-failed",
    "critical-validation-failed",
    "rollback-unavailable",
    "manual-decision-required-and-not-provided"
    ,"calculator-reference-study-incomplete"
    ,"calculator-experience-plan-not-approved"
    ,"calculator-result-contract-unresolved"
    ,"calculator-applicable-blocker-anti-pattern"
    ,"calculator-false-visual-pass"
    ,"calculator-recommendation-source-unapproved"
  ]
}
