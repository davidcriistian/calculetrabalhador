    "preconditions": { "type": "array", "items": { "type": "string" } },
    "status": { "type": "string" },
    "versioning": { "type": "object" },
    "rollback": { "type": "object" },
    "modifiesProductionInThisPhase": { "type": "boolean" }
  }
}
