{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "/data/blueprints/schemas/article-blueprint.schema.json",
  "title": "Article Blueprint",
  "allOf": [
    { "$ref": "/data/blueprints/schemas/blueprint.schema.json" },
    {
      "type": "object",
      "required": ["blueprintType", "identity", "seo", "structure", "testing", "validation", "publishing"],
      "properties": {
        "blueprintType": { "const": "article" },
        "identity": { "type": "object" },
        "seo": { "type": "object" },
        "structure": { "type": "object" },
        "testing": { "type": "object" },
        "validation": { "type": "object" },
        "publishing": { "type": "object" }
      }
    }
  ]
}
