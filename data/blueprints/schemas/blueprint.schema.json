{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "/data/blueprints/schemas/blueprint.schema.json",
  "title": "Blueprint System Shared Metadata",
  "type": "object",
  "required": ["id", "version", "status", "createdAt", "updatedAt", "owner", "source", "notes"],
  "properties": {
    "id": { "type": "string" },
    "version": { "type": "string" },
    "schema": { "type": "string" },
    "status": { "type": "string" },
    "runtimeStatus": { "type": "string" },
    "createdAt": { "type": "string" },
    "updatedAt": { "type": "string" },
    "owner": { "type": "string" },
    "source": { "type": "string" },
    "description": { "type": "string" },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
