  },
  "structure": {
    "publicExperienceBoundary": {
      "principle": "INTERNAL GOVERNANCE METADATA MUST NOT LEAK INTO PUBLIC USER EXPERIENCE",
      "publicLayer": ["user-benefit", "plain-language-guidance", "actionable-errors", "trust-context"],
      "internalLayer": ["rule-version", "projection-fingerprint", "stale-state", "reconciliation-count", "legal-review-status", "registry-status", "publishing-status", "governance-architecture"],
      "source": "/data/blueprints/contracts/calculator-experience.contract.json#publicExperienceBoundaryContract"
    },
    "contentLayers": {
      "permanentBeforeCalculation": ["hero", "intro", "simulator", "editorial-or-methodology", "faq", "related-content", "sources", "footer"],
      "dynamicAfterCalculation": ["result", "indicators", "interpretation", "CANONICAL_RESULT_RECOMMENDATION_SLOT", "calculation-memory", "comparisons", "limitations", "result-actions"]
    },
    "visualStructure": [
      "hero",
      "calculator-form",
      "result-section",
      "cards",
      "faq",
      "related-content",
      "disclaimer"
    ],
    "components": [
      "hero",
      "section",
      "calculator-card",
      "result-card",
      "info-card",
      "faq",
      "cta",
      "offer-slot",
      "related-content",
      "disclaimer",
      "breadcrumb"
    ],
    "moduleResolution": {
      "requiredCoreModulesSource": "/data/blueprints/contracts/calculator-experience.contract.json#requiredCoreModules",
      "conditionalModulesSource": "/data/blueprints/contracts/calculator-experience.contract.json#conditionalModules",
      "optionalEnhancementsSource": "/data/blueprints/contracts/calculator-experience.contract.json#optionalEnhancements",
      "requiredModuleFields": ["id", "purpose", "minimumContent", "depth", "behavior", "validationEvidence", "referenceRelation", "relatedAntiPatterns"],
      "conditionalDecisionRequired": true,
      "presenceOnlyIsSufficient": false
    },
    "experienceClassification": {
      "formComplexityClassRequired": true,
      "formClasses": ["SIMPLE_SINGLE_STEP", "GUIDED_MULTI_GROUP", "GUIDED_MULTI_STEP", "CONDITIONAL_FLOW"],
      "resultExperienceClassRequired": true,
      "resultClasses": ["SIMPLE_RESULT", "CALCULATION_REPORT", "DECISION_REPORT", "COMPARATIVE_REPORT"],
      "calculationMemoryLevelRequired": true,
      "memoryLevels": ["MEMORY_NOT_REQUIRED", "BASIC_MEMORY", "STEP_BY_STEP_MEMORY", "AUDITABLE_MEMORY"],
      "classificationJustificationRequired": true
    },
    "fields": [],
    "calculations": {
      "modelReference": null,
      "coreDomainReference": null,
      "runtimeReference": null,
      "formulaNotes": []
    },
    "result": {
      "resultFields": [],
      "formattingRules": [],
      "emptyState": null,
      "errorState": null,
      "recommendationSlot": "CANONICAL_RESULT_RECOMMENDATION_SLOT",
      "recommendationSlotPosition": "after-interpretation-before-calculation-memory",
      "adaptiveReportDeclarations": ["REPORT_INPUT_FIELDS", "REPORT_PRIMARY_RESULT", "REPORT_SECONDARY_RESULTS", "REPORT_MEMORY_SECTIONS", "REPORT_INTERPRETATION", "REPORT_LIMITATIONS", "REPORT_OPTIONAL_SECTIONS"]
