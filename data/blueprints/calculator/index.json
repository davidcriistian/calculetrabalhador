    "product": null,
    "cta": null,
    "offerSlot": null,
    "tracking": {
      "events": [],
      "parameters": []
    }
  },
  "testing": {
    "required": true,
    "testingReference": "/data/pos/testing/index.json",
    "requiredEvidence": ["calculation-baseline", "json-output", "reference-study", "module-decomposition", "experience-plan", "editorial-word-count", "updated-at-equivalence", "report-render", "negative-standard-tests", "visual-evidence-or-manual-approval", "manual-review"]
  },
  "validation": {
    "required": true,
    "validationReference": "/data/pos/validation/index.json",
    "requiredTypes": ["calculator-structure-validation", "calculation-validation", "governance-validation", "result-experience-validation", "visual-render-validation", "responsive-validation", "accessibility-validation", "seo-validation", "jsonld-validation", "human-approval"],
    "requiredGates": ["REFERENCE_STUDY_COMPLETE", "CALCULATOR_EXPERIENCE_PLAN_APPROVED", "RESULT_CONTRACT_RESOLVED", "VISUAL_VALIDATION_STATUS_RESOLVED", "ANTI_PATTERN_GATE", "CONTENT_DEPTH_GATE", "BRAND_THEME_RESOLVED", "VISIBLE_UPDATED_AT_RESOLVED", "EDITORIAL_DEPTH_RESOLVED", "RECOMMENDATION_SLOT_RESOLVED", "ADAPTIVE_REPORT_CONTRACT_RESOLVED", "REPORT_RENDER_VALIDATED", "PUBLIC_EXPERIENCE_BOUNDARY_RESOLVED"]
  },
  "publishing": {
    "required": true,
    "status": "not-ready",
    "requiresManualApproval": true,
    "modifiesProductionInThisPhase": false,
    "newStandardRule": "VISUAL_VALIDATION_NOT_EXECUTED cannot produce FULL_STANDARD_ACCEPTED",
    "recommendationRule": "Render recommendations only from approved configuration and eligibility evidence"
  },
  "assetCompatibility": {
    "LEGACY_ASSET": "LEGACY_ACCEPTED_PENDING_MIGRATION",
