    "createGuideCardOnHome": false,
    "ambiguousTopicAction": "MANUAL_DECISION_REQUIRED",
    "requiredGates": ["NUCLEUS_EXISTENCE_RESOLVED", "NUCLEUS_CANDIDATE_RESOLVED"]
  },
  "identity": {
    "name": "Example Calculator",
    "category": "example-category",
    "nucleus": "example-nucleus",
