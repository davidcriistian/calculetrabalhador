    "SPECIALIZED_EXCEPTION_REVIEW": "Automation cannot migrate without human review."
  },
  "definitiveProtocol": {
    "id": "CONTROLLED_CALCULATOR_MIGRATION_PROTOCOL",
    "requiredSequence": [
      "PRE_MIGRATION_RECONNAISSANCE",
      "BASELINE_FREEZE",
      "CANONICAL_RULE_RECONCILIATION_WHEN_APPLICABLE",
