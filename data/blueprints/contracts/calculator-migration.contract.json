      "newMigrationAfterConsolidation": "FULL_PROTOCOL_REQUIRED"
    }
  },
  "batchMigrationProtocol": {
    "defaultMaximumAssets": 3,
    "conditionalMaximumAssets": 4,
    "fourAssetCondition": "PROVEN_HOMOGENEOUS_FAMILY_AND_RULES",
    "specializedMaximumAssets": 1,
    "individualRequiredEvidence": ["identity", "baseline", "formula", "rule", "consumers", "dependencies", "seo-preservation", "editorial-preservation", "tests", "evidence", "rollback", "status", "human-acceptance"],
    "sharedBatchEvidence": ["visual-family", "protocol", "execution", "common-validators", "consolidated-report"],
    "mustRemainIndividual": ["baseline", "formula", "rule", "result", "rollback", "legal-decision"],
    "individualStates": ["READY", "READY_WITH_GUARDS", "BLOCKED", "REVIEW_REQUIRED", "MIGRATED", "HUMAN_ACCEPTED", "HOMOLOGATED"],
    "failureIsolationRule": "Block only the affected asset when technically isolated; never infer approval by batch association.",
    "baselinePolicy": {"REGRESSION_BASELINE_READY":"MAY_PROCEED","REGRESSION_BASELINE_PARTIAL":"ADDITIONAL_FREEZE_REQUIRED","REGRESSION_BASELINE_MISSING":"BLOCKED"},
    "unreconciledRulePolicy": "BLOCKED_FOR_PUBLIC_MIGRATION"
  },
  "boundaries": {
