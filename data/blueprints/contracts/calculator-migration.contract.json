    "HEURISTIC_WARNING": "Evidence may nominate a review candidate but cannot confirm a governed dependency.",
    "HUMAN_REVIEW_REQUIRED": "Semantic, legal or specialized judgment must be recorded before continuation."
  },
  "compatibility": {
    "LEGACY_ACCEPTED_PENDING_MIGRATION": "Accepted without retroactive certification.",
