{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "/data/blueprints/shared/pam/schemas/platform-asset-model.schema.json",
  "title": "Platform Asset Model",
  "type": "object",
  "required": [
    "id",
    "version",
    "schema",
    "status",
    "runtimeStatus",
    "createdAt",
    "updatedAt",
    "owner",
    "source",
    "modelType",
    "identity",
    "relationships",
    "lifecycle",
    "governance",
    "metadata",
    "audit",
    "inheritance",
    "nonResponsibilities",
    "operationalBoundaries"
  ],
  "properties": {
    "id": { "type": "string" },
    "version": { "type": "string" },
    "schema": { "type": "string" },
    "status": { "type": "string" },
    "runtimeStatus": { "type": "string" },
    "createdAt": { "type": "string" },
    "updatedAt": { "type": "string" },
    "owner": { "type": "string" },
    "source": { "type": "string" },
    "description": { "type": "string" },
    "modelType": { "const": "shared-base-model" },
    "architectureAuthority": { "type": "string" },
    "relationshipAuthority": { "type": "string" },
    "identity": { "$ref": "/data/blueprints/shared/pam/schemas/pam-identity.schema.json" },
    "relationships": { "$ref": "/data/blueprints/shared/pam/schemas/pam-relationships.schema.json" },
    "lifecycle": { "$ref": "/data/blueprints/shared/pam/schemas/pam-lifecycle.schema.json" },
    "governance": { "$ref": "/data/blueprints/shared/pam/schemas/pam-governance.schema.json" },
    "metadata": { "$ref": "/data/blueprints/shared/pam/schemas/pam-metadata.schema.json" },
    "audit": { "$ref": "/data/blueprints/shared/pam/schemas/pam-audit.schema.json" },
    "inheritance": { "type": "object" },
    "nonResponsibilities": { "type": "array", "items": { "type": "string" } },
    "operationalBoundaries": { "type": "object" },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
