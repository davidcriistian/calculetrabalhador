{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "/data/blueprints/guide/schemas/guide-blueprint.schema.json",
  "title": "Guide Blueprint",
  "type": "object",
  "required": [
    "id",
    "version",
    "schema",
    "status",
    "runtimeStatus",
    "createdAt",
    "updatedAt",
    "owner",
    "source",
    "blueprintType",
    "identity",
    "visualStructure",
    "seo",
    "dynamicContent",
    "ordering",
    "relationships",
    "testing",
    "validation",
    "publishing"
  ],
  "properties": {
    "id": { "type": "string" },
    "version": { "type": "string" },
    "schema": { "type": "string" },
    "status": { "type": "string" },
    "runtimeStatus": { "type": "string" },
    "createdAt": { "type": "string" },
    "updatedAt": { "type": "string" },
    "owner": { "type": "string" },
    "source": { "type": "string" },
    "description": { "type": "string" },
    "blueprintType": { "const": "guide" },
    "relationshipAuthority": { "type": "string" },
    "identity": { "type": "object" },
    "visualStructure": { "type": "object" },
    "seo": { "type": "object" },
    "dynamicContent": { "type": "object" },
    "ordering": { "type": "object" },
    "relationships": { "$ref": "/data/blueprints/guide/schemas/guide-relation.schema.json" },
    "testing": { "type": "object" },
    "validation": { "type": "object" },
    "publishing": { "type": "object" },
    "operationalBoundaries": { "type": "object" },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
