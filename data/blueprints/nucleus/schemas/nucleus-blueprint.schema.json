{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "/data/blueprints/nucleus/schemas/nucleus-blueprint.schema.json",
  "title": "Nucleus Blueprint",
  "type": "object",
  "required": [
    "id",
    "version",
    "schema",
    "status",
    "runtimeStatus",
    "createdAt",
    "updatedAt",
    "owner",
    "source",
    "blueprintType",
    "identity",
    "relationships",
    "governance",
    "growth",
    "testing",
    "validation",
    "publishing",
    "homeDistribution",
    "progressiveProvisioning"
  ],
  "properties": {
    "id": { "type": "string" },
    "version": { "type": "string" },
    "schema": { "type": "string" },
    "status": { "type": "string" },
    "runtimeStatus": { "type": "string" },
    "createdAt": { "type": "string" },
    "updatedAt": { "type": "string" },
    "owner": { "type": "string" },
    "source": { "type": "string" },
    "description": { "type": "string" },
    "blueprintType": { "const": "nucleus" },
    "relationshipAuthority": { "type": "string" },
    "distributionContract": { "type": "object" },
    "identity": { "type": "object" },
    "relationships": { "$ref": "/data/blueprints/nucleus/schemas/nucleus-relation.schema.json" },
    "governance": { "type": "object" },
    "growth": { "$ref": "/data/blueprints/nucleus/schemas/nucleus-growth.schema.json" },
    "testing": { "type": "object" },
    "validation": { "type": "object" },
    "publishing": { "type": "object" },
    "homeDistribution": {
      "type": "object",
      "required": ["sectionType", "source", "eligibility", "responsivePresentation"],
      "properties": {
        "sectionType": { "const": "NUCLEUS_ARTICLE_SECTION" },
        "source": { "const": "GOVERNED_NUCLEUS_ARTICLES" },
        "eligibility": { "const": "HAS_PUBLISHED_ARTICLES" },
        "responsivePresentation": { "type": "object" }
      }
    },
    "progressiveProvisioning": { "type": "object" },
    "operationalBoundaries": { "type": "object" },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
