    "employeeResignationNoticeDays": 30,
    "employeeDiscountLimitDays": 30,
    "comparisonTolerance": 0.01
  },
  "conditions": {
    "fullYearTreatment": "count completed calendar anniversaries; fractions do not add days",
    "employer_termination": {
      "appliesWhen": "dismissal without cause initiated by employer",
      "totalEntitlement": "30 plus 3 days per completed year, capped at 90",
      "proportional_entitlement": "employee right and employer obligation"
    },
    "employee_resignation": {
      "appliesWhen": "termination initiated by employee",
      "noticeObligationDays": 30,
      "proportionalityAgainstEmployeeAllowed": false
    },
    "worked_notice": {
      "maximumWorkedDays": 30,
      "proportionalExcessHandling": "indemnified, not automatically required as additional work"
    },
    "indemnified_notice": {
      "fullyIndemnified": "all employer-termination entitlement days are indemnified",
      "mixedNotice": "entitlement above the worked period is indemnified"
    },
    "employee_discount_limit": {
      "maximumDays": 30,
      "appliesWhen": "employee resignation notice is not fulfilled and employer does not waive it"
    },
    "collectiveRules": "not modeled; a collective rule may require case-specific review"
  },
  "formulas": {
    "fullYears": "max(calendar year difference adjusted when endDate precedes the anniversary, 0)",
    "employerTerminationTotalDays": "min(maximumTotalDays, baseDays + fullYears * additionalDaysPerFullYear)",
    "employerTerminationProportionalDays": "employerTerminationTotalDays - baseDays",
    "fullyIndemnifiedWorkedDays": "0",
    "fullyIndemnifiedDays": "employerTerminationTotalDays",
    "workedNoticeDays": "min(maximumWorkedDays, employerTerminationTotalDays)",
    "workedNoticeIndemnifiedDays": "employerTerminationTotalDays - workedNoticeDays",
    "employeeResignationTotalDays": "employeeResignationNoticeDays",
    "employeeResignationDiscountDays": "min(employeeDiscountLimitDays, employeeResignationNoticeDays)",
    "dailyValue": "salary / salaryDivisorDays",
    "estimatedValue": "monetaryDays * dailyValue"
  },
  "noticeTypeContracts": {
    "indenizado": {
      "legalScenario": "employer_termination",
      "totalDays": "employerTerminationTotalDays",
      "workedDays": 0,
      "indemnifiedDays": "employerTerminationTotalDays",
      "discountDays": 0,
      "monetaryDays": "employerTerminationTotalDays"
    },
    "trabalhado": {
      "legalScenario": "employer_termination",
      "totalDays": "employerTerminationTotalDays",
      "workedDays": "min(30, employerTerminationTotalDays)",
      "indemnifiedDays": "employerTerminationTotalDays - workedDays",
      "discountDays": 0,
      "monetaryDays": "employerTerminationTotalDays"
    },
    "desconto": {
