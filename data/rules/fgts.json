        "intermediateCalculation": "raw JavaScript Number arithmetic",
        "finalResult": "round withdrawal and remaining balance to two decimal places"
      },
      "rounding": {
        "method": "Math.round((value + Number.EPSILON) * 100) / 100",
        "stage": "withdrawal and remaining balance final outputs",
        "intermediateRounding": false,
        "currencyDisplay": "Intl.NumberFormat pt-BR BRL",
        "moneyScale": 2
      },
      "validation": {
        "validWhen": "balance is a finite number greater than zero",
        "invalidWhen": [
          "balance is missing",
          "balance is not finite",
          "balance is zero or negative"
        ],
        "invalidResult": {
          "state": "EMPTY",
          "withdrawal": 0,
          "remainingBalance": 0,
          "band": null
        },
        "inputParserCompatibility": {
          "mode": "DIGITS_AS_CENTS",
