{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "/data/gold-standards/schemas/gold-standard-component.schema.json",
  "title": "Gold Standard Component",
  "type": "object",
  "required": ["id", "version", "status", "runtimeStatus", "createdAt", "updatedAt", "owner", "components"],
  "properties": {
    "id": { "type": "string" },
    "version": { "type": "string" },
    "schema": { "type": "string" },
    "status": { "type": "string" },
    "runtimeStatus": { "type": "string" },
    "createdAt": { "type": "string" },
    "updatedAt": { "type": "string" },
    "owner": { "type": "string" },
    "source": { "type": "string" },
    "description": { "type": "string" },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "requiredQualities"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "requiredQualities": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
