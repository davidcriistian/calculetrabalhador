  "source": "Programa 1 - Homologacao da Plataforma - Sprint 1",
  "domainId": "adicional-noturno",
  "calculationFormula": {
    "normalHourValue": "salary / monthlyHours",
    "additionalPerHour": "normalHourValue * (percent / 100)",
    "totalValue": "additionalPerHour * nightHours"
  },
  "displayRules": {
    "currency": "Intl.NumberFormat pt-BR BRL",
    "percent": "two decimal places with comma",
    "hours": "two decimal places with comma"
  },
