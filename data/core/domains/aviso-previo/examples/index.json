{
  "id": "aviso-previo-examples",
  "version": "0.2.0",
  "status": "homologation",
  "createdAt": "2026-07-09",
  "updatedAt": "2026-07-09",
  "owner": "Calcule Trabalhador",
  "source": "Programa 1 - Homologacao da Plataforma - Sprint 2",
  "domainId": "aviso-previo",
  "calculationFormula": {
    "fullYears": "complete anniversaries between startDate and endDate",
    "baseDays": 30,
    "rawAdditionalDays": "fullYears * 3",
    "totalDays": "min(90, baseDays + rawAdditionalDays)",
    "additionalDays": "totalDays - baseDays",
    "dailyValue": "salary / 30",
    "estimatedValue": "totalDays * dailyValue"
  },
  "items": [
