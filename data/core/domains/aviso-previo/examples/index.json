      "expected": { "valid": true, "companyTime": "11 meses, 30 dias", "fullYears": 0, "baseDays": 30, "rawAdditionalDays": 0, "additionalDays": 0, "totalDays": 30, "dailyValue": 100, "estimatedValue": 3000 }
    },
