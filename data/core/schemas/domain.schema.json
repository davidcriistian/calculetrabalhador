{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "/data/core/schemas/domain.schema.json",
  "title": "Core Engine Domain",
  "type": "object",
  "required": ["id", "slug", "name", "description", "status", "owner", "createdAt", "updatedAt", "currentVersion", "activeYear", "dependencies", "references", "tags", "futureModules"],
  "properties": {
    "id": { "type": "string" },
    "slug": { "type": "string" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "status": { "type": "string" },
    "owner": { "type": "string" },
    "createdAt": { "type": "string" },
    "updatedAt": { "type": "string" },
    "currentVersion": { "type": "string" },
    "activeYear": { "type": "string" },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "references": { "type": "array", "items": { "type": "string" } },
    "tags": { "type": "array", "items": { "type": "string" } },
    "futureModules": { "type": "array", "items": { "type": "string" } }
  }
}
