  "$id": "/data/core/schemas/reference.schema.json",
  "title": "Core Engine Reference",
  "type": "object",
  "required": ["id", "name", "url", "agency", "credibility", "lastCheckedAt", "status"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
