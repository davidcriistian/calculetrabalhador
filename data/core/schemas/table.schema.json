{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "/data/core/schemas/table.schema.json",
  "title": "Core Engine Table",
  "type": "object",
  "required": ["id", "year", "version", "status", "validFrom", "source", "rows"],
  "properties": {
    "id": { "type": "string" },
    "year": { "type": "string" },
    "version": { "type": "string" },
    "status": { "type": "string" },
    "validFrom": { "type": "string" },
    "validTo": { "type": ["string", "null"] },
    "source": { "$ref": "/data/core/schemas/reference.schema.json" },
    "rows": { "type": "array", "items": { "type": "object" } },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
