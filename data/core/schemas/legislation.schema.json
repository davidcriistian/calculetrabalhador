{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "/data/core/schemas/legislation.schema.json",
  "title": "Core Engine Legislation",
  "type": "object",
  "required": ["id", "type", "title", "status", "version", "validFrom", "responsibleAgency", "officialLinks"],
  "properties": {
    "id": { "type": "string" },
    "type": { "type": "string" },
    "title": { "type": "string" },
    "summary": { "type": "string" },
    "status": { "type": "string" },
    "version": { "type": "string" },
    "validFrom": { "type": "string" },
    "validTo": { "type": ["string", "null"] },
    "responsibleAgency": { "type": "string" },
    "officialLinks": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
