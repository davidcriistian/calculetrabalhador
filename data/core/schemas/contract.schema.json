{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "/data/core/schemas/contract.schema.json",
  "title": "Core Engine Contract",
  "allOf": [
    { "$ref": "/data/core/schemas/shared-metadata.schema.json" },
    {
      "type": "object",
      "required": ["name", "objective", "expectedInputs", "expectedOutputs", "dependencies"],
      "properties": {
        "name": { "type": "string" },
        "objective": { "type": "string" },
        "expectedInputs": { "type": "array", "items": { "type": "string" } },
        "expectedOutputs": { "type": "array", "items": { "type": "string" } },
        "dependencies": { "type": "array", "items": { "type": "string" } }
      }
    }
  ]
}
