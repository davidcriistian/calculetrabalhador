{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "/data/core/schemas/metadata.schema.json",
  "title": "Core Engine Metadata",
  "type": "object",
  "required": ["version", "status", "createdAt", "updatedAt", "owner"],
  "properties": {
    "version": { "type": "string" },
    "schema": { "type": "string" },
    "status": { "type": "string" },
    "runtimeStatus": { "type": "string" },
    "createdAt": { "type": "string" },
    "updatedAt": { "type": "string" },
    "owner": { "type": "string" },
    "officialRuntime": { "type": "string" },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
