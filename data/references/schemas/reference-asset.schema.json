{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "/data/references/schemas/reference-asset.schema.json",
  "title": "Reference Asset",
  "type": "object",
  "required": [
    "id",
    "name",
    "type",
    "url",
    "slug",
    "status",
    "goldStandardType",
    "goldStandardVersion",
    "approved",
    "approvedDate",
    "owner",
    "referenceCriteria",
    "notes",
    "supersedes",
    "supersededBy"
  ],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "type": { "type": "string" },
    "url": { "type": "string" },
    "slug": { "type": "string" },
    "status": { "type": "string" },
    "goldStandardType": { "type": "string" },
    "goldStandardVersion": { "type": "string" },
    "approved": { "type": "boolean" },
    "approvedDate": { "type": "string" },
    "owner": { "type": "string" },
    "description": { "type": "string" },
    "referenceCriteria": {
      "type": "array",
      "items": { "$ref": "/data/references/schemas/reference-criteria.schema.json" }
    },
    "notes": { "type": "array", "items": { "type": "string" } },
    "supersedes": { "type": ["string", "null"] },
    "supersededBy": { "type": ["string", "null"] }
  }
}
