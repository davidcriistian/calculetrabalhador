{
  "id": "reference-system-versioning",
  "version": "0.1.0",
  "schema": "/data/references/schemas/reference.schema.json",
  "status": "foundation",
  "runtimeStatus": "not-consumed",
  "createdAt": "2026-07-10",
  "updatedAt": "2026-07-10",
  "owner": "Calcule Trabalhador",
  "source": "Productivity Layer Phase 2.5 - Reference System",
  "description": "Versioning policy for Reference System.",
  "policy": {
    "semanticVersioning": true,
    "major": "Breaking changes to reference entry shape or approval model.",
    "minor": "New reference asset types, criteria or official references.",
    "patch": "Non-breaking metadata or documentation clarification."
  },
  "replacementPolicy": {
    "referencesMayChangeWithoutGoldStandardChange": true,
    "requiresApprovalRecord": true,
    "usesSupersedesSupersededBy": true
  },
  "notes": [
    "Changing an official reference does not change the Gold Standard.",
    "Future references should preserve approval history."
  ]
}
