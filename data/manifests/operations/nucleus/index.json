{
  "id": "nucleus-operation-manifests",
  "version": "0.2.0",
  "schema": "/data/manifests/schemas/manifest.schema.json",
  "status": "foundation",
  "runtimeStatus": "not-consumed",
  "createdAt": "2026-07-10",
  "updatedAt": "2026-07-14",
  "owner": "Calcule Trabalhador",
  "source": "Operational Capabilities Phase 4.1 - Nucleus Operations",
  "description": "Manifest entry points for official nucleus operations.",
  "manifestRules": {
    "manifestIsMandatoryEntryPoint": true,
    "readMinimumContextFirst": true,
    "useExistingArchitectureOnly": true,
    "noNewLayer": true,
    "noNewEngine": true
  },
  "controlledHomeDistributionException": {
    "allowedScope": ["Home runtime", "Home stylesheet", "governed nucleus projection", "internal automation"],
    "requiredContract": "/data/blueprints/nucleus/home-distribution.contract.json",
    "forbiddenScope": ["articles", "calculators", "Guide pages", "legal rules", "IndexNow", "deploy", "git write"]
  },
  "blockedFiles": [
    "calculators",
    "articles",
    "public-guides",
    "HTML",
    "CSS",
    "production-JavaScript",
    "runtime",
    "current-SEO",
    "URLs",
    "sitemap.xml",
    ".htaccess",
    "data/tools.json",
    "data/articles.json",
    "data/tabelas-trabalhistas.json",
    "assets/js/tabelas-trabalhistas.js",
    "data/brain/nuclei.json",
    "blog/categoria",
    "pending-public-working-tree-files"
  ],
  "manifests": [
    {
      "operationId": "create-nucleus",
      "objective": "Prepare a new nucleus and primary guide through declarative specifications.",
      "minimumContext": ["Architecture Evolution Policy", "Domain Relationship Model", "PAM", "Nucleus Blueprint", "Guide Blueprint", "Gold Standard", "Registry System", "Publishing Model"],
      "requiredInputs": ["nucleusName", "nucleusSlug", "primaryDomain", "objective", "targetAudience", "searchIntent", "owner", "initialClusters", "goldStandardVersion", "strategyVersion"],
      "optionalInputs": ["commercialPositioning", "editorialPositioning", "referenceVersion", "eligibleProducts", "eligibleCtas"],
      "preconditions": ["domain-exists", "slug-available", "nucleus-not-existing", "blueprints-valid", "pam-valid", "canonical-relationship-available"],
      "requiredBlueprints": ["/data/blueprints/nucleus/index.json", "/data/blueprints/guide/index.json", "/data/blueprints/shared/pam/index.json"],
      "requiredStandards": ["Gold Standard"],
      "requiredReferences": ["Reference System when applicable"],
      "requiredRegistries": ["Registry System", "POS Registry"],
      "playbook": "/data/operations/playbooks/nucleus/index.json#create-nucleus",
      "workflow": "/data/operations/workflows/nucleus/index.json#create-nucleus-workflow",
      "testing": ["relationship-integrity", "catalog-integrity", "navigation-integrity", "empty-state"],
      "validation": ["pam-compliance", "nucleus-blueprint-compliance", "guide-blueprint-compliance", "gold-standard-compliance"],
      "publishing": ["draft", "preview", "review", "approval", "ready-to-publish"],
      "expectedOutputs": ["nucleusSpecification", "guideSpecification", "relationshipMap", "plannedAssets", "testingPlan", "validationPlan", "publishingPlan", "operationReport"],
      "reportType": "create-nucleus-report"
    },
    {
      "operationId": "expand-nucleus",
      "objective": "Prepare expansion of an existing nucleus with new planned assets or capabilities.",
      "minimumContext": ["Target Nucleus", "Primary Guide", "Domain Relationship Model", "Registry System", "Manifest Context", "Relevant Blueprint", "Publishing Model"],
      "requiredInputs": ["nucleusId", "expansionType", "objective", "owner"],
      "optionalInputs": ["newCluster", "newCalculator", "newPillarArticle", "newSatelliteArticle", "relatedGuide", "faq", "glossary", "download", "eligibleProduct", "eligibleCta"],
      "preconditions": ["nucleus-exists", "primary-guide-valid", "canonical-relationship-intact", "new-asset-not-duplicated", "corresponding-blueprint-available"],
      "requiredBlueprints": ["/data/blueprints/nucleus/index.json", "/data/blueprints/guide/index.json", "/data/blueprints/cluster/index.json", "/data/blueprints/calculator/index.json", "/data/blueprints/article/index.json"],
      "requiredStandards": ["Gold Standard"],
      "requiredReferences": ["Reference System when applicable"],
      "requiredRegistries": ["Registry System"],
      "playbook": "/data/operations/playbooks/nucleus/index.json#expand-nucleus",
      "workflow": "/data/operations/workflows/nucleus/index.json#expand-nucleus-workflow",
      "testing": ["relationship-consistency-check", "internal-link-check", "duplicate-prevention"],
      "validation": ["relationship-validation", "cluster-validation", "seo-safety", "publishing-readiness"],
      "publishing": ["publishing-plan-only"],
      "expectedOutputs": ["expansionScope", "newAssetSpecifications", "relationshipMap", "dependencyPlan", "testingPlan", "validationPlan", "publishingPlan", "operationReport"],
      "reportType": "expand-nucleus-report"
    },
    {
      "operationId": "update-nucleus",
      "objective": "Prepare controlled updates to existing nucleus configuration, strategy or metadata.",
      "minimumContext": ["Target Nucleus", "Primary Guide", "Baseline", "PAM Lifecycle", "Domain Relationship Model", "Publishing Model"],
      "requiredInputs": ["nucleusId", "changeType", "changeReason", "owner"],
      "optionalInputs": ["objective", "targetAudience", "searchIntent", "priority", "featured", "ordering", "guideSeo", "editorialStrategy", "commercialStrategy", "status", "goldStandardVersion", "blueprintVersion"],
      "preconditions": ["baseline-captured", "target-nucleus-identified", "impact-scope-defined"],
      "requiredBlueprints": ["/data/blueprints/nucleus/index.json", "/data/blueprints/guide/index.json", "/data/blueprints/shared/pam/index.json"],
      "requiredStandards": ["Gold Standard when quality target changes"],
      "requiredReferences": ["Reference System when implementation standard changes"],
      "requiredRegistries": ["Registry System"],
      "playbook": "/data/operations/playbooks/nucleus/index.json#update-nucleus",
      "workflow": "/data/operations/workflows/nucleus/index.json#update-nucleus-workflow",
      "testing": ["regression-when-applicable", "relationship-consistency-check"],
      "validation": ["pam-compliance", "relationship-validation", "seo-validation-when-guide-seo-changes"],
      "publishing": ["publishing-impact-plan"],
      "expectedOutputs": ["baseline", "impactClassification", "dependentAssets", "declarativeChangePlan", "rollbackPlan", "testingPlan", "validationPlan", "publishingPlan", "changeLog", "operationReport"],
      "reportType": "update-nucleus-report"
    },
    {
      "operationId": "validate-nucleus",
      "objective": "Validate the integrity of a nucleus and its primary guide.",
      "minimumContext": ["Target Nucleus", "Primary Guide", "PAM", "Domain Relationship Model", "Nucleus Blueprint", "Guide Blueprint", "Gold Standard", "Testing Evidence", "Validation Rules", "Publishing Model"],
      "requiredInputs": ["nucleusId", "guideId", "validationScope", "owner"],
      "optionalInputs": ["strictMode", "includePublishingReadiness", "includeSeoReview"],
      "preconditions": ["target-nucleus-identified", "primary-guide-identified", "validation-scope-selected"],
      "requiredBlueprints": ["/data/blueprints/nucleus/index.json", "/data/blueprints/guide/index.json", "/data/blueprints/shared/pam/index.json"],
      "requiredStandards": ["Gold Standard"],
      "requiredReferences": ["Reference System when applicable"],
      "requiredRegistries": ["Registry System", "POS Registry"],
      "playbook": "/data/operations/playbooks/nucleus/index.json#validate-nucleus",
      "workflow": "/data/operations/workflows/nucleus/index.json#validate-nucleus-workflow",
      "testing": ["relationship-integrity", "catalog-integrity", "navigation-integrity", "link-integrity", "seo-regression", "layout-regression", "content-aggregation", "empty-state", "duplicate-prevention"],
      "validation": ["pam-compliance", "gold-standard-compliance", "seo", "json-ld", "breadcrumb", "headings", "responsiveness", "accessibility", "links", "components", "structure", "nucleus-guide-relationship"],
      "publishing": ["rollback-readiness", "publishing-readiness"],
      "expectedOutputs": ["validationStatus", "warnings", "failures", "evidence", "nextAction", "operationReport"],
      "reportType": "validate-nucleus-report"
    },
    {
      "operationId": "publish-nucleus",
      "objective": "Prepare future publication of a nucleus and its primary guide through Publishing gates.",
      "minimumContext": ["Validated Nucleus", "Validated Guide", "Testing Pass", "Validation Pass", "Publishing Model", "Rollback Plan", "Manual Approval"],
      "requiredInputs": ["nucleusId", "guideId", "releaseId", "owner"],
      "optionalInputs": ["sitemapPlan", "indexingPlan", "deployPlan", "rollbackOwner"],
      "preconditions": ["validate-nucleus-approved", "testing-approved", "validation-approved", "gold-standard-compliant", "manual-approval", "rollback-ready", "sitemap-ready", "indexing-ready", "deploy-ready"],
      "requiredBlueprints": ["/data/blueprints/nucleus/index.json", "/data/blueprints/guide/index.json"],
      "requiredStandards": ["Gold Standard"],
      "requiredReferences": ["Reference System when applicable"],
      "requiredRegistries": ["Registry System", "POS Registry"],
      "playbook": "/data/operations/playbooks/nucleus/index.json#publish-nucleus",
      "workflow": "/data/operations/workflows/nucleus/index.json#publish-nucleus-workflow",
      "testing": ["pre-publish-regression"],
      "validation": ["publishing-validation", "seo-validation", "runtime-safety"],
      "publishing": ["release-specification", "deploy-plan", "sitemap-plan", "indexing-plan", "rollback-plan", "publication-log-template"],
      "expectedOutputs": ["releaseSpecification", "deployPlan", "sitemapPlan", "indexingPlan", "rollbackPlan", "publicationLogTemplate", "operationReport"],
      "reportType": "publish-nucleus-report"
    },
    {
      "operationId": "progressive-nucleus-provisioning",
      "objective": "Resolve candidate, first-article provisioning and future-article reuse without empty or duplicate Home sections.",
      "minimumContext": ["Nucleus Home Distribution Contract", "Nucleus Blueprint", "Article Blueprint", "Calculator Blueprint", "Registry", "Publishing", "Content Map"],
      "requiredInputs": ["assetType", "topicIdentity", "relatedAssetIds", "existingNucleusResolution"],
      "preconditions": ["semantic-duplicate-check", "domain-conflict-check", "slug-collision-check", "taxonomy-resolution"],
      "requiredBlueprints": ["/data/blueprints/nucleus/index.json", "/data/blueprints/article/index.json", "/data/blueprints/calculator/index.json"],
      "playbook": "/data/operations/playbooks/nucleus/index.json#progressive-nucleus-provisioning",
      "workflow": "/data/operations/workflows/nucleus/index.json#progressive-nucleus-provisioning-workflow",
      "testing": ["candidate-without-section", "first-article-eligibility", "responsive-limits", "cross-nucleus-isolation", "idempotency"],
      "validation": ["all-nucleus-home-gates", "ambiguity-guard", "rollback-readiness"],
      "expectedOutputs": ["candidateResolution", "provisioningResolution", "homeSectionResolution", "rollbackPlan", "operationReport"],
      "reportType": "progressive-nucleus-provisioning-report"
    }
  ],
  "notes": [
    "These manifests are declarative and do not execute operations.",
    "No public page, sitemap, deploy, IndexNow call or Git operation is executed by this phase."
  ]
}
