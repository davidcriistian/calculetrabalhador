{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "/data/manifests/schemas/manifest.schema.json",
  "title": "Operational Manifest",
  "type": "object",
  "required": ["id", "version", "status", "runtimeStatus", "createdAt", "updatedAt", "owner", "source"],
  "properties": {
    "id": { "type": "string" },
    "version": { "type": "string" },
    "schema": { "type": "string" },
    "status": { "type": "string" },
    "runtimeStatus": { "type": "string" },
    "createdAt": { "type": "string" },
    "updatedAt": { "type": "string" },
    "owner": { "type": "string" },
    "source": { "type": "string" },
    "description": { "type": "string" },
    "manifestRules": { "type": "object" },
    "manifests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "operationId",
          "objective",
          "description",
          "preconditions",
          "requiredLayers",
          "requiredFiles",
          "optionalFiles",
          "requiredBlueprints",
          "requiredPlaybooks",
          "requiredTesting",
          "requiredValidation",
          "restrictions",
          "blockedFiles",
          "dependencies",
          "expectedResult",
          "expectedReport"
        ],
        "properties": {
          "operationId": { "type": "string" },
          "objective": { "type": "string" },
          "description": { "type": "string" },
          "preconditions": { "type": "array", "items": { "type": "string" } },
          "requiredLayers": { "type": "array", "items": { "type": "string" } },
          "requiredFiles": { "type": "array", "items": { "type": "string" } },
          "optionalFiles": { "type": "array", "items": { "type": "string" } },
          "requiredBlueprints": { "type": "array", "items": { "type": "string" } },
          "requiredPlaybooks": { "type": "array", "items": { "type": "string" } },
          "requiredTesting": { "type": "array", "items": { "type": "string" } },
          "requiredValidation": { "type": "array", "items": { "type": "string" } },
          "restrictions": { "type": "array", "items": { "type": "string" } },
          "blockedFiles": { "type": "array", "items": { "type": "string" } },
          "dependencies": { "type": "array", "items": { "type": "string" } },
          "expectedResult": { "type": "string" },
          "expectedReport": { "type": "string" }
        }
      }
    },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
