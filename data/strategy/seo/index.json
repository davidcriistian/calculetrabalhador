  "description": "Configurable SEO policies.",
  "policies": {
    "minimumInternalLinks": 3,
    "faqRecommended": true,
    "jsonLdRequired": true,
    "relatedContentRequired": true,
    "headingStrategy": "single-h1-ordered-h2-h3",
    "metaStrategy": "unique-title-and-description",
    "internalLinking": "cluster-first",
    "structure": ["title", "meta-description", "canonical", "breadcrumb", "headings", "faq", "related-content"]
  },
  "notes": [
    "SEO strategy is declarative and does not alter existing SEO."
  ]
