{
  "id": "constitution-architecture",
  "version": "0.2.0",
  "schema": "/data/constitution/schemas/constitution.schema.json",
  "status": "foundation",
  "runtimeStatus": "not-consumed",
  "createdAt": "2026-07-09",
  "updatedAt": "2026-07-09",
  "owner": "Calcule Trabalhador",
  "source": "Constitution Governance Rule - Architecture Evolution Policy",
  "description": "Official constitutional architecture boundaries.",
  "officialLayers": [
    "constitution",
    "strategy",
    "core",
    "pos",
    "blueprints",
    "compatibility",
    "legislation",
    "update",
    "shadow"
  ],
  "allowedDependencies": [
    { "from": "strategy", "to": "constitution", "type": "must-respect" },
    { "from": "pos", "to": "core", "type": "consumes-approved-knowledge" },
    { "from": "blueprints", "to": "strategy", "type": "uses-current-strategy" },
    { "from": "blueprints", "to": "constitution", "type": "must-respect" },
    { "from": "testing", "to": "shadow", "type": "may-use-evidence" },
    { "from": "validation", "to": "testing", "type": "requires-approval" }
  ],
  "forbiddenDependencies": [
    { "from": "blueprints", "to": "legal-rules", "reason": "Blueprints must not own legal knowledge." },
    { "from": "core", "to": "operational-rules", "reason": "Core must not own operational process." },
    { "from": "strategy", "to": "runtime", "reason": "Strategy must not modify production directly." },
    { "from": "constitution", "to": "runtime", "reason": "Constitution is principle-only." }
  ],
  "flows": [
    "Constitution -> Strategy -> Platform Architecture -> Core -> Gold Standards -> Reference System -> Platform Asset Model -> Blueprint System -> Registry -> Operations -> Manifest -> Migration -> Testing -> Validation -> Publishing",
    "Reuse -> Extension -> Justification -> Audit -> Approval",
    "Core -> POS operations -> Testing -> Validation",
    "Legislation -> Update -> Compatibility -> Core impact planning"
  ],
  "architectureEvolutionPolicy": "/data/constitution/governance/architecture-evolution-policy.json",
  "freeze": {
    "architectureFoundation": "frozen",
    "newTransversalModels": "blocked",
    "newLayers": "exception-only",
    "operationalCapabilities": "active-development"
  },
  "notes": [
    "This file documents architecture rules and does not enforce them automatically.",
    "No lower layer may redefine a higher layer."
  ]
}
