    "source and destination mapping",
    "allowed and blocked file policy",
    "pre-check definition",
    "post-check definition",
    "approval gates",
    "rollback metadata",
    "batch migration planning",
    "audit trail",
    "PRESERVE-RESTRUCTURE_WITHOUT_REWRITING-MIGRATE-GOVERN-HUMAN_REVIEW_REQUIRED classification",
    "regression baseline gate",
    "typed governed dependency mapping",
    "single-source engine and visible-rule validation",
    "migration family selection"
