    "target asset reference",
    "migration type",
    "migration reason",
    "risk level",
    "file policy",
    "approval status"
  ],
  "expectedOutputs": [
    "migration plan record",
    "migration report",
    "gate decision record",
    "impact notes",
    "rollback reference",
    "batch migration record",
    "heritage preservation record",
    "baseline gate decision",
    "typed dependency plan",
    "governed rule impact analysis",
    "human review requirements"
  ],
  "dependencies": [
    "/data/pos/registry/index.json",
    "/data/pos/versioning/index.json",
    "/data/pos/migration/index.json",
    "/data/blueprints/contracts/calculator-migration.contract.json",
