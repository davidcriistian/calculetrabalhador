    "projection": "./templates/projection.template.json",
    "dependency": "./templates/dependency.template.json"
  },
  "queue": "./batches/index.json",
  "engine": "../engines/ingestion-engine.js",
  "packageVersion": "2.7.0-sprint5.6.7-phaseE",
  "catalogVersion": "1.0.0",
  "versionSemantics": {
