{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "domain-source-catalog.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "domainId",
    "catalogVersion",
    "status",
    "scope",
    "items",
    "verification"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "domainId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "catalogVersion": {
      "type": "string"
    },
    "status": {
      "enum": [
        "DRAFT",
        "SOURCES_VALIDATED"
      ]
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "path",
          "role",
          "applicability",
          "pinpoints",
          "supports"
        ],
        "properties": {
          "sourceId": {
            "type": "string",
            "pattern": "^SRC-[A-Z0-9-]+$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "primary-normative",
              "jurisprudential",
              "administrative",
              "scope-boundary"
            ]
          },
          "applicability": {
            "enum": [
              "included",
              "excluded",
              "conditional"
            ]
          },
          "pinpoints": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "supports": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verifiedAt",
        "verifiedBy",
        "method",
        "officialDomains",
        "notes"
      ],
      "properties": {
        "verifiedAt": {
          "type": "string",
          "format": "date-time"
        },
        "verifiedBy": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "officialDomains": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
