{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source.schema.json",
  "title": "Official Source",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "jurisdiction",
    "title",
    "status",
    "retrievedAt",
    "evidence",
    "checksum"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^SRC-[A-Z0-9-]+$"
    },
    "type": {
      "enum": [
        "constitution",
        "law",
        "decree",
        "ordinance",
        "normative-instruction",
        "resolution",
        "court-decision",
        "official-table",
        "official-guidance",
        "other"
      ]
    },
    "jurisdiction": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "officialUrl": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "publicationDate": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "effectiveFrom": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "effectiveTo": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "retrievedAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "draft",
        "verified",
        "superseded",
        "revoked",
        "archived"
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "value"
        ],
        "properties": {
          "kind": {
            "enum": [
              "url",
              "local-copy",
              "excerpt",
              "checksum",
              "citation"
            ]
          },
          "value": {
            "type": "string"
          },
          "capturedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    },
    "checksum": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(sha256:)?[a-f0-9]{64}$"
    },
    "supersedesSourceId": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
