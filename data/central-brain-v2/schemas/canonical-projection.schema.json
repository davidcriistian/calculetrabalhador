{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "canonical-projection.schema.json",
  "title": "Canonical Legal Projection Definition",
  "description": "Versioned declarative definition that derives legal conclusions from facts and canonical rules.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "domainId",
    "title",
    "purpose",
    "version",
    "status",
    "effectiveFrom",
    "effectiveTo",
    "ruleRefs",
    "conceptIds",
    "inputFacts",
    "activation",
    "exceptions",
    "dependencies",
    "outputs",
    "explanation",
    "governance",
    "testCaseIds"
  ],
  "$defs": {
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "factId",
        "operator"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^COND-[A-Z0-9-]+$"
        },
        "factId": {
          "type": "string",
          "pattern": "^FACT-[A-Z0-9-]+$"
        },
        "operator": {
          "enum": [
            "equals",
            "not-equals",
            "in",
            "not-in",
            "exists",
            "not-exists",
            "greater-than",
            "greater-than-or-equal",
            "less-than",
            "less-than-or-equal",
            "before",
            "on-or-before",
            "after",
            "on-or-after"
          ]
        },
        "value": {},
        "values": {
          "type": "array",
          "minItems": 1
        },
        "onUnknown": {
          "enum": [
            "insufficient-facts",
            "false",
            "human-review"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 3
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operator": {
                "enum": [
                  "equals",
                  "not-equals",
                  "greater-than",
                  "greater-than-or-equal",
                  "less-than",
                  "less-than-or-equal",
                  "before",
                  "on-or-before",
                  "after",
                  "on-or-after"
                ]
              }
            }
          },
          "then": {
            "required": [
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "operator": {
                "enum": [
                  "in",
                  "not-in"
                ]
              }
            }
          },
          "then": {
            "required": [
              "values"
            ]
          }
        }
      ]
    },
    "ruleRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleId",
        "versionPolicy",
        "role"
      ],
      "properties": {
        "ruleId": {
          "type": "string",
          "pattern": "^RULE-[A-Z0-9-]+$"
        },
        "versionPolicy": {
          "enum": [
            "effective-at-reference-date",
            "effective-at-fact-date",
            "pinned"
          ]
        },
        "pinnedVersionId": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^VER-[A-Z0-9-]+$"
        },
        "factDateId": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^FACT-[A-Z0-9-]+$"
        },
        "role": {
          "enum": [
            "authoritative",
            "supporting",
            "exception",
            "scope-boundary"
          ]
        }
      }
    },
    "inputFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "factId",
        "requirement",
        "purpose"
      ],
      "properties": {
        "factId": {
          "type": "string",
          "pattern": "^FACT-[A-Z0-9-]+$"
        },
        "requirement": {
          "enum": [
            "required",
            "conditional",
            "optional"
          ]
        },
        "requiredWhenConditionIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^COND-[A-Z0-9-]+$"
          }
        },
        "purpose": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "valueType",
        "semantics",
        "source"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
        },
        "valueType": {
          "enum": [
            "string",
            "integer",
            "number",
            "boolean",
            "date",
            "date-time",
            "duration-days",
            "enum",
            "object",
            "array",
            "operation-instruction",
            "projection-reference"
          ]
        },
        "semantics": {
          "type": "string",
          "minLength": 5
        },
        "source": {
          "enum": [
            "constant",
            "fact",
            "condition-result",
            "rule-effect",
            "derived-operation",
            "dependency-output"
          ]
        },
        "sourceRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "nullable": {
          "type": "boolean"
        },
        "allowedValues": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true
        },
        "consumerVisibility": {
          "enum": [
            "public",
            "internal",
            "audit-only"
          ]
        },
        "defaultValue": {},
        "valueMap": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^PROJ-[A-Z0-9-]+$"
    },
    "domainId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 5
    },
    "purpose": {
      "type": "string",
      "minLength": 15
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "enum": [
        "draft",
        "review",
        "approved",
        "deprecated",
        "retired"
      ]
    },
    "effectiveFrom": {
      "type": "string",
      "format": "date"
    },
    "effectiveTo": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "ruleRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/ruleRef"
      }
    },
    "conceptIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^CPT-[A-Z0-9-]+$"
      }
    },
    "inputFacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/inputFact"
      }
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logic",
        "conditions",
        "defaultOutcome"
      ],
      "properties": {
        "logic": {
          "enum": [
            "all",
            "any",
            "expression"
          ]
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/predicate"
          }
        },
        "expression": {
          "type": [
            "string",
            "null"
          ]
        },
        "defaultOutcome": {
          "enum": [
            "not-applicable",
            "insufficient-facts",
            "human-review"
          ]
        }
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "priority",
          "conditions",
          "outcome",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^EXC-[A-Z0-9-]+$"
          },
          "priority": {
            "type": "integer",
            "minimum": 1
          },
          "conditions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/predicate"
            }
          },
          "outcome": {
            "enum": [
              "not-applicable",
              "override",
              "human-review",
              "insufficient-facts"
            ]
          },
          "outputOverrides": {
            "type": "object"
          },
          "reason": {
            "type": "string",
            "minLength": 5
          },
          "ruleIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^RULE-[A-Z0-9-]+$"
            }
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "projectionId",
          "requirement",
          "failurePolicy"
        ],
        "properties": {
          "projectionId": {
            "type": "string",
            "pattern": "^PROJ-[A-Z0-9-]+$"
          },
          "requirement": {
            "enum": [
              "required",
              "optional"
            ]
          },
          "failurePolicy": {
            "enum": [
              "propagate",
              "human-review",
              "continue-without"
            ]
          },
          "consumesOutputs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/output"
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "operationType",
          "inputs",
          "outputKey"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^OP-[A-Z0-9-]+$"
          },
          "operationType": {
            "enum": [
              "calendar-add-days",
              "completed-years-between",
              "bounded-linear-duration",
              "copy-value",
              "map-value",
              "aggregate-effects",
              "effective-bounded-linear-duration",
              "consolidation-status",
              "unresolved-projections",
              "date-add-days"
            ]
          },
          "inputs": {
            "type": "object"
          },
          "outputKey": {
            "type": "string"
          },
          "determinism": {
            "const": "pure"
          },
          "timezonePolicy": {
            "enum": [
              "date-only",
              "UTC",
              "consumer-supplied-IANA",
              "not-applicable"
            ]
          },
          "temporalPolicyId": {
            "type": "string",
            "pattern": "^TEMPORAL-POLICY-[A-Z0-9-]+$"
          }
        }
      }
    },
    "explanation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summaryTemplate",
        "includeFacts",
        "includeRules",
        "includeRejectedRules",
        "includeExceptions"
      ],
      "properties": {
        "summaryTemplate": {
          "type": "string",
          "minLength": 10
        },
        "includeFacts": {
          "type": "boolean"
        },
        "includeRules": {
          "type": "boolean"
        },
        "includeRejectedRules": {
          "type": "boolean"
        },
        "includeExceptions": {
          "type": "boolean"
        },
        "publicLimitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "legalReviewRequired",
        "technicalReviewRequired",
        "runtimeAuthority",
        "consumerReady",
        "createdAt",
        "lastReviewedAt"
      ],
      "properties": {
        "owner": {
          "type": "string"
        },
        "legalReviewRequired": {
          "type": "boolean"
        },
        "technicalReviewRequired": {
          "type": "boolean"
        },
        "runtimeAuthority": {
          "const": false
        },
        "consumerReady": {
          "const": false
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "lastReviewedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "reviewId": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "testCaseIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^TC-PROJ-[A-Z0-9-]+$"
      }
    },
    "contentFingerprint": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "explanations": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 3
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "approved"
          }
        }
      },
      "then": {
        "properties": {
          "governance": {
            "properties": {
              "lastReviewedAt": {
                "type": "string",
                "format": "date-time"
              },
              "reviewId": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ]
}
