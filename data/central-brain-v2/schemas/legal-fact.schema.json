{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "legal-fact.schema.json",
  "title": "Canonical Legal Fact Definition",
  "description": "Defines a stable, typed legal fact that may be supplied or derived during projection execution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "domainId",
    "key",
    "label",
    "description",
    "valueType",
    "originPolicy",
    "temporalSemantics",
    "evidencePolicy",
    "privacy",
    "status",
    "version",
    "governance",
    "contentFingerprint"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^FACT-[A-Z0-9-]+$"
    },
    "domainId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "label": {
      "type": "string",
      "minLength": 3
    },
    "description": {
      "type": "string",
      "minLength": 10
    },
    "valueType": {
      "enum": [
        "string",
        "integer",
        "number",
        "boolean",
        "date",
        "date-time",
        "duration-days",
        "enum",
        "money",
        "identifier",
        "object",
        "array"
      ]
    },
    "allowedValues": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": [
          "string",
          "number",
          "integer",
          "boolean"
        ]
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "minLength": {
          "type": "integer",
          "minimum": 0
        },
        "maxLength": {
          "type": "integer",
          "minimum": 0
        },
        "pattern": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "itemsType": {
          "type": "string"
        }
      }
    },
    "originPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowedOrigins",
        "derivationAllowed"
      ],
      "properties": {
        "allowedOrigins": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "user-declared",
              "document-extracted",
              "system-observed",
              "official-record",
              "derived"
            ]
          }
        },
        "derivationAllowed": {
          "type": "boolean"
        },
        "derivationProjectionIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^PROJ-[A-Z0-9-]+$"
          }
        }
      }
    },
    "temporalSemantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "referenceRole"
      ],
      "properties": {
        "kind": {
          "enum": [
            "atemporal",
            "event-date",
            "period-start",
            "period-end",
            "reference-date",
            "recorded-at"
          ]
        },
        "referenceRole": {
          "enum": [
            "none",
            "admission",
            "communication",
            "termination",
            "projected-termination",
            "legal-reference",
            "evidence-recorded"
          ]
        },
        "timezonePolicy": {
          "enum": [
            "not-applicable",
            "date-only",
            "UTC",
            "consumer-supplied-IANA"
          ]
        }
      }
    },
    "evidencePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "acceptedEvidenceTypes",
        "minimumConfidence"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "acceptedEvidenceTypes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "declaration",
              "document",
              "official-record",
              "system-record",
              "derived-trace"
            ]
          }
        },
        "minimumConfidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "humanVerificationRequired": {
          "type": "boolean"
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "retentionClass"
      ],
      "properties": {
        "classification": {
          "enum": [
            "public",
            "internal",
            "personal",
            "sensitive-personal"
          ]
        },
        "retentionClass": {
          "enum": [
            "ephemeral",
            "case-lifetime",
            "audit-required",
            "indefinite-canonical"
          ]
        },
        "redactionRequired": {
          "type": "boolean"
        }
      }
    },
    "status": {
      "enum": [
        "draft",
        "review",
        "approved",
        "deprecated",
        "retired"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "conceptIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?:CON|CPT)-[A-Z0-9-]+$"
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "legalReviewRequired",
        "technicalReviewRequired",
        "createdAt",
        "lastReviewedAt"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 2
        },
        "legalReviewRequired": {
          "type": "boolean"
        },
        "technicalReviewRequired": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "lastReviewedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "reviewId": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "relationships": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dependsOnFactIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^FACT-[A-Z0-9-]+$"
          }
        },
        "conflictsWithFactIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^FACT-[A-Z0-9-]+$"
          }
        },
        "requiredWithFactIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^FACT-[A-Z0-9-]+$"
          }
        },
        "mutuallyExclusiveGroup": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "semanticValidation": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "assertion",
          "message"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^FVAL-[A-Z0-9-]+$"
          },
          "severity": {
            "enum": [
              "error",
              "warning",
              "review"
            ]
          },
          "assertion": {
            "type": "string",
            "minLength": 5
          },
          "message": {
            "type": "string",
            "minLength": 10
          },
          "relatedFactIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^FACT-[A-Z0-9-]+$"
            }
          }
        }
      }
    },
    "legalBasis": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "pinpoint",
          "relevance"
        ],
        "properties": {
          "sourceId": {
            "type": "string",
            "pattern": "^SRC-[A-Z0-9-]+$"
          },
          "pinpoint": {
            "type": "string"
          },
          "relevance": {
            "type": "string",
            "minLength": 5
          }
        }
      }
    },
    "contentFingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "valueType": {
            "const": "enum"
          }
        },
        "required": [
          "valueType"
        ]
      },
      "then": {
        "required": [
          "allowedValues"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "originPolicy": {
            "properties": {
              "derivationAllowed": {
                "const": true
              }
            },
            "required": [
              "derivationAllowed"
            ]
          }
        },
        "required": [
          "originPolicy"
        ]
      },
      "then": {
        "properties": {
          "originPolicy": {
            "required": [
              "derivationProjectionIds"
            ]
          }
        }
      }
    }
  ]
}
