{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "domain-glossary.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "domainId",
    "status",
    "items"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "domainId": {
      "type": "string"
    },
    "status": {
      "enum": [
        "IDENTITY_TERMS_ONLY",
        "VALIDATED"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "term",
          "definitionStatus"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "term": {
            "type": "string"
          },
          "definitionStatus": {
            "enum": [
              "pending-legal-validation",
              "validated"
            ]
          }
        }
      }
    }
  }
}
