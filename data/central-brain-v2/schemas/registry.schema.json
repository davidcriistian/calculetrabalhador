{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "registry.schema.json",
  "title": "Registry Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kind",
    "items",
    "status",
    "updatedAt"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "domains",
        "sources",
        "rules",
        "projections",
        "dependencies",
        "consumers",
        "audit-events"
      ]
    },
    "items": {
      "type": "array"
    },
    "status": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "note": {
      "type": "string"
    },
    "authority": {
      "type": "boolean"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
