{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "concept.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "domainId",
    "canonicalName",
    "slug",
    "semanticType",
    "definition",
    "scope",
    "sourceRefs",
    "aliases",
    "relations",
    "status",
    "version",
    "governance"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^CPT-[A-Z0-9-]+$"
    },
    "domainId": {
      "type": "string"
    },
    "canonicalName": {
      "type": "string",
      "minLength": 2
    },
    "slug": {
      "type": "string"
    },
    "semanticType": {
      "enum": [
        "institution",
        "modality",
        "duration",
        "event",
        "effect",
        "procedure",
        "party-role",
        "scope-qualifier"
      ]
    },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "nature",
        "interpretiveLimit"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "nature": {
          "enum": [
            "normative-synthesis",
            "terminological-synthesis",
            "jurisprudential-synthesis"
          ]
        },
        "interpretiveLimit": {
          "type": "string"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "regimes",
        "jurisdiction",
        "exclusions"
      ],
      "properties": {
        "regimes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "jurisdiction": {
          "type": "string"
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "sourceRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "pinpoints",
          "support"
        ],
        "properties": {
          "sourceId": {
            "type": "string"
          },
          "pinpoints": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "support": {
            "type": "string"
          }
        }
      }
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "targetConceptId",
          "status"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "targetConceptId": {
            "type": "string"
          },
          "status": {
            "enum": [
              "validated",
              "declared",
              "pending-validation"
            ]
          }
        }
      }
    },
    "status": {
      "enum": [
        "validated",
        "draft",
        "deprecated"
      ]
    },
    "version": {
      "type": "string"
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "createdAt",
        "reviewedAt",
        "reviewedBy",
        "consumerAuthority"
      ],
      "properties": {
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "reviewedAt": {
          "type": "string",
          "format": "date-time"
        },
        "reviewedBy": {
          "type": "string"
        },
        "consumerAuthority": {
          "type": "boolean"
        }
      }
    }
  }
}
