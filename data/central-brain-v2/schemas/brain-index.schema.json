{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "brain-index.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$id",
    "version",
    "status",
    "runtimeAuthority",
    "createdAt",
    "owner",
    "purpose",
    "principles",
    "entrypoints",
    "safety"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "$id": {
      "const": "central-brain-v2"
    },
    "version": {
      "type": "string"
    },
    "status": {
      "enum": [
        "parallel-only",
        "shadow",
        "active",
        "retired"
      ]
    },
    "runtimeAuthority": {
      "type": "boolean"
    },
    "createdAt": {
      "type": "string",
      "format": "date"
    },
    "owner": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "principles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "entrypoints": {
      "type": "object",
      "required": [
        "registries",
        "schemas",
        "contracts",
        "engines",
        "governance",
        "migration",
        "validation"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "safety": {
      "type": "object",
      "required": [
        "connectedToCurrentCalculators",
        "connectedToCurrentArticles",
        "connectedToAutomations",
        "connectedToPanel"
      ],
      "additionalProperties": {
        "type": "boolean"
      }
    }
  }
}
