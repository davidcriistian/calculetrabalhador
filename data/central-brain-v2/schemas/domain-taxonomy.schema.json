{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "domain-taxonomy.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "domainId",
    "classification",
    "tags",
    "facets"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "domainId": {
      "type": "string"
    },
    "classification": {
      "type": "object",
      "required": [
        "root",
        "branch",
        "category"
      ],
      "additionalProperties": false,
      "properties": {
        "root": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "category": {
          "type": "string"
        }
      }
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "facets": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
}
