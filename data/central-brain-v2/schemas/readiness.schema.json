{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "readiness.schema.json",
  "title": "Brain Readiness State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "generatedAt",
    "gates",
    "overall"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "overall": {
      "enum": [
        "NOT_READY",
        "READY_FOR_CONTROLLED_INGESTION",
        "READY_FOR_SHADOW_CONSUMPTION",
        "RUNTIME_AUTHORITY"
      ]
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z0-9_]+$"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_APPLICABLE"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "blocking": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
